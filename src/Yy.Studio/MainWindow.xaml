<Window x:Class="Yy.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:props="clr-namespace:Yy.Studio.Properties"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:studio="clr-namespace:Yy.Studio"
        xmlns:local="clr-namespace:Yy.Studio"
        xmlns:structured="clr-namespace:Yy.Studio.Structured"
        Title="易语 Studio"
        Icon="Assets/YyStudio.ico"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing"
        StateChanged="OnMainWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E5E9EE" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D5DBE2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#A52618" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewFileCommand}" Executed="OnNewFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.NewProjectCommand}" Executed="OnNewProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.NewFormCommand}" Executed="OnNewForm"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFileCommand}" Executed="OnOpenFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFolderCommand}" Executed="OnOpenFolder"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveFileCommand}" Executed="OnSaveFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="OnSaveAs"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.CloseTabCommand}" Executed="OnCloseTab"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.CompileProjectCommand}" Executed="OnCompileProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.RunCommand}" Executed="OnRun"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.RunProjectCommand}" Executed="OnRunProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.StopCommand}" Executed="OnStop"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.DebugStepCommand}" Executed="OnDebugStep"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.DebugStepOverCommand}" Executed="OnDebugStepOver"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.DebugStepOutCommand}" Executed="OnDebugStepOut"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.DebugRunToCursorCommand}" Executed="OnDebugRunToCursor"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.DebugToggleBreakpointCommand}" Executed="OnDebugToggleBreakpoint"
                        xmlns:local="clr-namespace:Yy.Studio" />
    </Window.CommandBindings>

    <Border x:Name="WindowFrame"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#B8C0C8"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <DockPanel x:Name="MainLayout" LastChildFill="True">
        <!-- ================= 自定义顶栏：窗口标题、菜单和窗口按钮共用一条操作栏 ================= -->
        <Border x:Name="WindowTitleBar"
                DockPanel.Dock="Top"
                Height="38"
                Background="#F6F8FA"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40"
                        Height="38"
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                    <Image Width="16"
                           Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="Assets/YyStudio.ico" />
                </Border>
                <Menu x:Name="MainMenu"
                      Grid.Column="1"
                      Height="38"
                      Background="Transparent"
                      Foreground="{StaticResource TextBrush}"
                      BorderThickness="0"
                      Padding="0"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_F程序" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="新建" Click="OnNewProgramClick" />
                <MenuItem Header="新建源码" InputGestureText="Ctrl+Shift+Alt+N"
                          Command="{x:Static local:MainWindow.NewFileCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="新建窗口" InputGestureText="Ctrl+Shift+N"
                          Command="{x:Static local:MainWindow.NewFormCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="打开">
                    <MenuItem Header="打开文件…" InputGestureText="Ctrl+O"
                              Command="{x:Static local:MainWindow.OpenFileCommand}"
                              xmlns:local="clr-namespace:Yy.Studio" />
                    <MenuItem Header="打开文件夹…" InputGestureText="Ctrl+Shift+O"
                              Command="{x:Static local:MainWindow.OpenFolderCommand}"
                              xmlns:local="clr-namespace:Yy.Studio" />
                </MenuItem>
                <MenuItem Header="关闭" InputGestureText="Ctrl+W"
                          Command="{x:Static local:MainWindow.CloseTabCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="保存" InputGestureText="Ctrl+S"
                          Command="{x:Static local:MainWindow.SaveFileCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="另存为" InputGestureText="Ctrl+Shift+S"
                          Command="{x:Static local:MainWindow.SaveAsCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="打印" InputGestureText="Ctrl+P" Click="OnPrintClick" />
                <MenuItem Header="系统配置" Click="OnSystemConfigClick" />
                <MenuItem Header="打开 Studio 配置文件" Click="OnOpenStudioConfigClick" />
                <MenuItem Header="支持库配置" Click="OnSupportConfigClick" />
                <MenuItem Header="易模块管理" Click="OnModuleManagerClick" />
                <MenuItem Header="程序配置" Click="OnProjectPropertiesClick" />
                <Separator />
                <MenuItem Header="退出" InputGestureText="Alt+F4" Click="OnExitClick" />
            </MenuItem>

            <MenuItem Header="_E编辑" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="剪切" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut" />
                <MenuItem Header="复制" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
                <MenuItem Header="粘贴" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste" />
                <MenuItem Header="全选" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem x:Name="InsertLocalVarMenuItem"
                          Header="插入局部变量"
                          InputGestureText="Ctrl+L"
                          Click="OnInsertLocalVariableClick" />
            </MenuItem>

            <MenuItem Header="_V查看" Style="{StaticResource TopMenuItem}">
                <MenuItem x:Name="ToggleStatusBarMenuItem" Header="状态条"
                          IsCheckable="True" IsChecked="True" Click="OnToggleStatusBar" />
                <Separator />
                <MenuItem Header="工作夹" InputGestureText="Alt+1" Click="OnShowWorkTab" Tag="程序" />
                <MenuItem Header="命令夹" InputGestureText="Alt+2" Click="OnShowWorkTab" Tag="支持库" />
                <MenuItem Header="工作与状态组合夹" InputGestureText="Alt+3" Click="OnToggleExplorer" />
                <MenuItem Header="窗口组件箱" InputGestureText="Alt+4" Click="OnToggleToolboxPanel" />
                <Separator />
                <MenuItem Header="全局变量表" Click="OnOpenDataTableView" Tag="全局变量" />
                <MenuItem Header="常量表" Click="OnOpenDataTableView" Tag="常量表" />
                <MenuItem Header="资源表" Click="OnOpenDataTableView" Tag="资源表" />
                <Separator />
                <MenuItem Header="预览被设计窗口" InputGestureText="Ctrl+Enter" Click="OnPreviewForm" />
            </MenuItem>

            <MenuItem Header="_I插入" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="新窗口" InputGestureText=""
                          Command="{x:Static local:MainWindow.NewFormCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem x:Name="InsertFunctionMenuItem" Header="新子程序" Click="OnInsertFunctionClick" />
                <MenuItem x:Name="InsertConstantMenuItem" Header="新常量" Click="OnInsertConstantClick" />
                <MenuItem Header="新资源">
                    <MenuItem Header="图片" Click="OnAddResourceClick" Tag="图片" />
                    <MenuItem Header="声音" Click="OnAddResourceClick" Tag="声音" />
                </MenuItem>
                <Separator />
                <MenuItem Header="插入局部变量" InputGestureText="Ctrl+L" Click="OnInsertLocalVariableClick" />
            </MenuItem>

            <MenuItem Header="_B数据库" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="数据库设计器" Click="OnDatabaseDesignerClick" />
                <MenuItem Header="数据绑定" Click="OnDataBindClick" />
            </MenuItem>

            <MenuItem Header="_R运行" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="运行" InputGestureText="F5"
                          Command="{x:Static local:MainWindow.RunCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="运行项目" InputGestureText="Ctrl+F5"
                          Command="{x:Static local:MainWindow.RunProjectCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="终止运行" InputGestureText="Shift+F5"
                          Command="{x:Static local:MainWindow.StopCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="单步" InputGestureText="F8"
                          Command="{x:Static local:MainWindow.DebugStepCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="单步跳过" InputGestureText="F10"
                          Command="{x:Static local:MainWindow.DebugStepOverCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="跳出" InputGestureText="Shift+F8"
                          Command="{x:Static local:MainWindow.DebugStepOutCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="到光标处" InputGestureText="F4"
                          Command="{x:Static local:MainWindow.DebugRunToCursorCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="切换断点" InputGestureText="F9"
                          Command="{x:Static local:MainWindow.DebugToggleBreakpointCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
            </MenuItem>

            <MenuItem Header="_C编译" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="编译原生 EXE" InputGestureText="F7"
                          Command="{x:Static local:MainWindow.CompileProjectCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="编译为易模块" Click="OnCompileModuleClick" />
            </MenuItem>

            <MenuItem Header="_T工具" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="菜单编辑器" InputGestureText="Ctrl+E" Click="OnMenuEditorClick" />
                <Separator />
                <MenuItem Header="程序配置" Click="OnProjectPropertiesClick" />
            </MenuItem>

            <MenuItem x:Name="WindowMenu" Header="_W窗口" Style="{StaticResource TopMenuItem}">
                <MenuItem x:Name="WindowMenuPlaceholder" Header="（无打开的窗口）" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_H帮助" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="语法速查" Click="OnSyntaxClick" />
                <MenuItem Header="关于易语 Studio" Click="OnAboutClick" />
            </MenuItem>
                </Menu>
                <TextBlock Grid.Column="2"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           Margin="18,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            AutomationProperties.Name="最小化窗口"
                            ToolTip="最小化"
                            Click="OnMinimizeWindowClick">
                        <Rectangle Width="10"
                                   Height="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CaptionMaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            AutomationProperties.Name="最大化窗口"
                            ToolTip="最大化"
                            Click="OnMaximizeRestoreWindowClick">
                        <Grid Width="12" Height="12">
                            <Rectangle x:Name="CaptionMaximizeIcon"
                                       Width="10"
                                       Height="10"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Canvas x:Name="CaptionRestoreIcon"
                                    Width="12"
                                    Height="12"
                                    Visibility="Collapsed">
                                <Rectangle Canvas.Left="3"
                                           Canvas.Top="0"
                                           Width="8"
                                           Height="8"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" />
                                <Rectangle Canvas.Left="0"
                                           Canvas.Top="3"
                                           Width="8"
                                           Height="8"
                                           Fill="#F6F8FA"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CaptionCloseButton"
                            Style="{StaticResource CloseCaptionButton}"
                            AutomationProperties.Name="关闭窗口"
                            ToolTip="关闭"
                            Click="OnCloseWindowClick">
                        <Path Width="10"
                              Height="10"
                              Data="M 1,1 L 9,9 M 9,1 L 1,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 提示、输入出组合夹(全宽,夹标签在顶) ================= -->
        <Border x:Name="BottomToolWindowPanel"
                DockPanel.Dock="Bottom"
                Height="172"
                MinHeight="96"
                Background="{StaticResource PanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="BottomTabs"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="{StaticResource WindowBrush}"
                            BorderThickness="0">
                    <TabItem Header="提示">
                        <TextBox x:Name="EditorHelpBox"
                                 Background="{StaticResource HintBrush}"
                                 Foreground="#000000"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Padding="10,6"
                                 FontFamily="Microsoft YaHei UI"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto" />
                    </TabItem>
                    <TabItem Header="输出">
                        <Grid Background="{StaticResource EditorBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource FaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="9,0">
                                    <TextBlock x:Name="RunInfoText"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Content="清空" Style="{StaticResource ToolButton}"
                                            Padding="8,2" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="OnClearOutput" />
                                </Grid>
                            </Border>
                            <TextBox x:Name="OutputBox"
                                     Grid.Row="1"
                                     Background="{StaticResource EditorBrush}"
                                     Foreground="#000000"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="12,8"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="调用表">
                        <ListBox x:Name="CallStackList"
                                 Background="{StaticResource EditorBrush}"
                                 Foreground="{StaticResource TextBrush}">
                            <ListBoxItem Content="（运行暂停时显示调用表）"
                                         Foreground="{StaticResource MutedBrush}" />
                        </ListBox>
                    </TabItem>
                    <TabItem Header="监视表">
                        <Grid Background="{StaticResource EditorBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource FaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Margin="6,3">
                                    <TextBox x:Name="WatchInputBox" Width="220" FontSize="11.5"
                                             VerticalContentAlignment="Center"
                                             KeyDown="OnWatchInputKeyDown" />
                                    <Button Content="加入监视" Style="{StaticResource ToolButton}"
                                            Padding="8,2" Margin="6,0,0,0"
                                            Click="OnWatchAddClick" />
                                    <Button Content="移除" Style="{StaticResource ToolButton}"
                                            Padding="8,2" Margin="6,0,0,0"
                                            Click="OnWatchRemoveClick" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="WatchList" Grid.Row="1" Margin="0"
                                     SelectionMode="Extended">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" = " />
                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="变量表">
                        <ListBox x:Name="VariableList" Margin="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" = " />
                                        <Run Text="{Binding Value, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="搜寻1">
                        <Grid Background="{StaticResource EditorBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource FaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Margin="6,3">
                                    <TextBox x:Name="SearchInputBox" Width="220" FontSize="11.5"
                                             VerticalContentAlignment="Center"
                                             KeyDown="OnSearchInputKeyDown" />
                                    <Button Content="查找" Style="{StaticResource ToolButton}"
                                            Padding="8,2" Margin="6,0,0,0"
                                            Click="OnSearchClick" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="SearchResultsList1" Grid.Row="1" Margin="0"
                                     MouseDoubleClick="OnSearchResultDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Line, Mode=OneWay}" FontWeight="SemiBold" Foreground="#000080" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="搜寻2">
                        <ListBox x:Name="SearchResultsList2" Margin="0"
                                 MouseDoubleClick="OnSearchResultDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Line, Mode=OneWay}" FontWeight="SemiBold" Foreground="#000080" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="剪辑历史">
                        <ListBox x:Name="ClipHistoryList" Margin="0"
                                 MouseDoubleClick="OnClipHistoryInsert">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ================= 状态条 ================= -->
        <Border x:Name="StatusBarRow"
                DockPanel.Dock="Bottom"
                Height="22"
                Background="{StaticResource AccentBrush}"
                BorderThickness="0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#4ADE80" />
                    <TextBlock x:Name="StatusText" Text="就绪"
                               Margin="7,0,0,0" FontSize="11"
                               Foreground="White" />
                </StackPanel>
                <Button x:Name="McpEndpointButton"
                        Grid.Column="1"
                        Content="MCP 未启用"
                        Tag=""
                        Margin="0,0,12,0"
                        Padding="7,1"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#DDEBFA"
                        FontSize="10.5"
                        Cursor="Hand"
                        ToolTip="点击复制 MCP HTTP 地址"
                        Click="OnCopyMcpEndpointClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="McpChrome"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="2">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="McpChrome"
                                            Property="Background"
                                            Value="#227AA8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="CaretText" Grid.Column="2" Text="行 1，列 1"
                           FontSize="11" Foreground="White"
                           Margin="0,0,18,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="UTF-8  ·  Windows 原生"
                           FontSize="11" Foreground="#DDEBFA"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 主体:左工作与状态组合夹 | 设计中心 | 右窗口组件箱 ================= -->
        <Grid Background="{StaticResource WorkspaceBrush}" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="260" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="BottomToolWindowRow" Height="172" MinHeight="96" />
            </Grid.RowDefinitions>

            <!-- 左:项目目录 -->
            <Border Grid.Column="0" x:Name="ProjectExplorerPanel"
                    Grid.RowSpan="3"
                    Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <TextBlock Text="项目"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TreeView x:Name="ProjectDirectoryTree"
                              SelectedItemChanged="OnDirectoryTreeSelectionChanged"
                              MouseDoubleClick="OnDirectoryTreeDoubleClick" />
                </DockPanel>
            </Border>

            <!-- 右:支持库、程序数据、属性 -->
            <Border Grid.Column="4" x:Name="RightToolsPanel"
                    Grid.RowSpan="3"
                    Margin="0,0,132,0"
                    Background="{StaticResource PanelBrush}">
                <TabControl x:Name="WorkTabs" TabStripPlacement="Top">
                    <TabItem Header="支持库">
                        <TreeView x:Name="SupportTree"
                                  SelectedItemChanged="OnSupportTreeSelectionChanged"
                                  PreviewMouseLeftButtonDown="OnSupportTreeDoubleClick" />
                    </TabItem>
                    <TabItem Header="程序">
                        <TreeView x:Name="ProjectTree"
                                  SelectedItemChanged="OnProjectTreeSelectionChanged"
                                  MouseDoubleClick="OnProjectTreeDoubleClick" />
                    </TabItem>
                    <TabItem Header="属性">
                    <DockPanel Grid.IsSharedSizeScope="True">
                        <ComboBox x:Name="PropertyObjectCombo"
                                  DockPanel.Dock="Top"
                                  Margin="4,4,4,2"
                                  Padding="5,3"
                                  SelectionChanged="OnPropertyObjectChanged"
                                  ToolTip="选择要查看属性的对象" />
                        <ComboBox x:Name="EventSelectorCombo"
                                  DockPanel.Dock="Bottom"
                                  Margin="4,2,4,4"
                                  Padding="5,3"
                                  SelectionChanged="OnEventSelectorChanged"
                                  ToolTip="在此处选择加入事件处理子程序">
                            <ComboBoxItem Content="在此处选择加入事件处理子程序" IsSelected="True" />
                        </ComboBox>
                        <ListBox x:Name="PropertyRows"
                                 Margin="4,2,4,2"
                                 BorderThickness="0"
                                 Background="{StaticResource EditorBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnPropertyGridSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" SharedSizeGroup="PropName" />
                                            <ColumnDefinition Width="*" SharedSizeGroup="PropValue" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="NameCell"
                                                Background="{StaticResource FaceBrush}"
                                                BorderBrush="{StaticResource SunkenShadowBrush}"
                                                BorderThickness="0,0,1,1"
                                                Padding="5,2">
                                            <TextBlock x:Name="NameText"
                                                       Text="{Binding Name}"
                                                       FontSize="11.5" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource EditorBrush}"
                                                BorderBrush="{StaticResource SunkenShadowBrush}"
                                                BorderThickness="0,0,1,1">
                                            <Grid>
                                                <TextBox x:Name="ValueBox"
                                                         Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="4,2"
                                                         FontSize="11.5"
                                                         KeyDown="OnPropertyRowKeyDown"
                                                         LostFocus="OnPropertyRowCommit" />
                                                <ComboBox x:Name="ValueBool"
                                                          ItemsSource="{x:Static props:PropertyRowCatalog.TrueFalse}"
                                                          SelectedItem="{Binding ValueText, Mode=TwoWay}"
                                                          Visibility="Collapsed"
                                                          Padding="3,1"
                                                          FontSize="11.5"
                                                          SelectionChanged="OnPropertyBoolCommit" />
                                                <ComboBox x:Name="ValueColor"
                                                          ItemsSource="{x:Static props:PropertyRowCatalog.ColorPresets}"
                                                          SelectedItem="{Binding ValueText, Mode=TwoWay}"
                                                          Visibility="Collapsed"
                                                          Padding="3,1"
                                                          FontSize="11.5"
                                                          SelectionChanged="OnPropertyBoolCommit">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="14" Height="11"
                                                                        BorderBrush="#808080" BorderThickness="1"
                                                                        Background="{Binding ., Converter={x:Static props:HexToBrushConverter.Instance}}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding .}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                            <Setter TargetName="ValueBox" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueBool" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Color">
                                            <Setter TargetName="ValueBox" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ValueColor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter TargetName="NameCell" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter TargetName="ValueBox" Property="IsEnabled" Value="False" />
                                            <Setter TargetName="ValueBool" Property="IsEnabled" Value="False" />
                                            <Setter TargetName="ValueColor" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter"
                          Grid.Column="1"
                          Grid.RowSpan="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <!-- 中:现代 IDE 文档区(顶部标签 + 路径导航 + 编辑器) -->
            <Grid x:Name="DocumentArea"
                  Grid.Column="2"
                  Grid.Row="0"
                  Background="{StaticResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelRaisedBrush}"
                        Grid.Row="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="›"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="EditorBreadcrumbText"
                                   Text="未打开文件"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border x:Name="CodeWindowBar"
                        Grid.Row="2"
                        Background="{StaticResource FaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CodeNavigationPanel"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="对象"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="2,0,6,0" />
                            <ComboBox x:Name="CodeObjectPicker"
                                      Width="190"
                                      Height="23"
                                      FontSize="11.5"
                                      SelectionChanged="OnCodeObjectPickerChanged" />
                            <TextBlock Text="过程"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="10,0,6,0" />
                            <ComboBox x:Name="CodeProcedurePicker"
                                      Width="230"
                                      Height="23"
                                      FontSize="11.5"
                                      SelectionChanged="OnCodeProcedurePickerChanged" />
                        </StackPanel>
                        <TextBlock x:Name="CodeWindowContext"
                                   Grid.Column="1"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,8,0"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <Button x:Name="EasyLanguageCodeButton"
                                    Content="易语言代码"
                                    Click="OnShowEasyLanguageCode"
                                    Style="{StaticResource PanelButton}"
                                    Padding="9,2"
                                    Margin="0,0,3,0"
                                    ToolTip="显示程序集、对象/过程、折叠标记和命令语法色" />
                            <Button x:Name="PlainCodeButton"
                                    Content="纯代码"
                                    Click="OnShowPlainCode"
                                    Style="{StaticResource PanelButton}"
                                    Padding="9,2"
                                    Margin="0,0,6,0"
                                    ToolTip="隐藏易语言导航装饰，以普通源码方式编辑" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="格式化"
                                Click="OnFormatPlainCode"
                                Style="{StaticResource PanelButton}"
                                Padding="9,2"
                                ToolTip="按易语块结构重新缩进和格式化当前代码" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource FaceBrush}"
                        Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="DocumentTabs"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnDocumentTabSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabChrome"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0,0,0,2"
                                                        Padding="10,0">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Setter TargetName="TabChrome" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource FaceBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TabIcon}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   MaxWidth="170"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DirtyMark}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="×"
                                                Tag="{Binding}"
                                                Click="OnCloseTabClick"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource MutedBrush}"
                                                Padding="5,0,0,0"
                                                Margin="5,0,0,0"
                                                FontSize="14"
                                                Cursor="Hand"
                                                ToolTip="关闭标签页" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Column="1"
                                   Text="F1 帮助 · Ctrl+Space 补全"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="8,0,4,0" />
                    </Grid>
                </Border>

                <avalon:TextEditor x:Name="Editor"
                                   Grid.Row="3"
                                   Background="{StaticResource EditorBrush}"
                                   Foreground="#000000"
                                   FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="{StaticResource MutedBrush}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="8,10,8,16"
                                   TextChanged="OnEditorTextChanged" />

                <structured:EasyLanguageCodeEditor x:Name="EasyLanguageEditor"
                                                        Grid.Row="3"
                                                        Visibility="Collapsed"
                                                        ModelChanged="OnEasyLanguageCodeChanged"
                                                        HintRequested="OnEasyLanguageHint" />

                <Border x:Name="ParameterHintBar"
                        Grid.Row="4"
                        Background="{StaticResource FaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ParameterHintText"
                               FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                               FontSize="10.5"
                               Foreground="#000080"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <studio:DataTableView x:Name="DataTableViewHost"
                                      Grid.Row="3"
                                      Grid.RowSpan="2"
                                      Visibility="Collapsed" />

                <Grid x:Name="DesignerPanel"
                      Grid.Row="3"
                      Grid.RowSpan="2"
                      Background="{StaticResource WorkspaceBrush}"
                      Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="28">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#ECE9D8"
                                BorderBrush="#000000"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- 官方样式蓝色标题栏 -->
                                <Border x:Name="DesignerTitleBar"
                                        Height="28"
                                        Padding="8,0,4,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#0A246A" Offset="0" />
                                            <GradientStop Color="#316AC5" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock x:Name="DesignerTitleText"
                                                   Text="窗口"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="DesignerMinGlyph"
                                                       Text="＿"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="DesignerMaxGlyph"
                                                       Text="❐"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <Border Width="24"
                                                    Height="19"
                                                    Background="#C0392B"
                                                    BorderBrush="#E8746B"
                                                    BorderThickness="1">
                                                <TextBlock Text="✕"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Canvas x:Name="DesignerCanvas"
                                        Width="800"
                                        Height="520"
                                        ClipToBounds="True"
                                        AllowDrop="True"
                                        Focusable="True"
                                        SizeChanged="OnDesignerCanvasSizeChanged"
                                        DragOver="OnDesignerCanvasDragOver"
                                        Drop="OnDesignerCanvasDrop"
                                        PreviewMouseLeftButtonDown="OnDesignerCanvasMouseDown"
                                        PreviewMouseMove="OnDesignerCanvasMouseMove"
                                        PreviewMouseLeftButtonUp="OnDesignerCanvasMouseUp"
                                        KeyDown="OnDesignerCanvasKeyDown">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="查看用户代码" Click="OnOpenFormCodeBehind" />
                                            <Separator />
                                            <MenuItem Header="剪切" InputGestureText="Ctrl+X"
                                                      Command="ApplicationCommands.Cut" />
                                            <MenuItem Header="复制" InputGestureText="Ctrl+C"
                                                      Command="ApplicationCommands.Copy" />
                                            <MenuItem Header="粘贴" InputGestureText="Ctrl+V"
                                                      Command="ApplicationCommands.Paste" />
                                            <MenuItem Header="全选" InputGestureText="Ctrl+A"
                                                      Click="OnSelectAllDesignerControls" />
                                            <Separator />
                                            <MenuItem Header="置前" Click="OnDesignerBringFront" />
                                            <MenuItem Header="置后" Click="OnDesignerSendBack" />
                                            <Separator />
                                            <MenuItem Header="预览窗体" InputGestureText="Ctrl+Enter" Click="OnPreviewForm" />
                                            <MenuItem Header="菜单编辑器" InputGestureText="Ctrl+E" Click="OnMenuEditorClick" />
                                            <Separator />
                                            <MenuItem Header="删除所选控件" Click="OnDeleteDesignerControl" />
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                    <Canvas.Background>
                                        <DrawingBrush TileMode="Tile"
                                                      Viewport="0,0,8,8"
                                                      ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#ECE9D8">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,8,8" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#808080">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,1,1" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Canvas.Background>
                                </Canvas>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <GridSplitter x:Name="BottomToolWindowSplitter"
                          Grid.Row="1"
                          Grid.Column="2"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ShowsPreview="True" />

            <Border Grid.Row="2"
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <ContentControl x:Name="BottomToolWindowHost" />
            </Border>

            <GridSplitter x:Name="InspectorSplitter"
                          Grid.Column="3"
                          Grid.RowSpan="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <!-- 右:窗口组件箱 -->
            <Border Grid.Column="4" x:Name="InspectorPanel"
                    Grid.RowSpan="3"
                    Width="132"
                    HorizontalAlignment="Right"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource FaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <TextBlock Text="基本组件"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <ListBox x:Name="ControlToolbox"
                             Margin="3"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnToolboxDoubleClick"
                             PreviewMouseLeftButtonDown="OnToolboxMouseDown"
                             PreviewMouseMove="OnToolboxMouseMove">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="48" />
                                <Setter Property="Height" Value="46" />
                                <Setter Property="Margin" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ToolTile"
                                                    Background="{StaticResource FaceBrush}"
                                                    BorderBrush="{StaticResource SunkenShadowBrush}"
                                                    BorderThickness="1"
                                                    Padding="3">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToolTile" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                                    <Setter TargetName="ToolTile" Property="BorderBrush" Value="{StaticResource SunkenDarkBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ToolTile" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                                    <Setter TargetName="ToolTile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource HighlightTextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock x:Name="ToolGlyph"
                                               Text="{Binding Glyph}"
                                               FontSize="15"
                                               Foreground="#000080"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ToolName"
                                               Text="{Binding DisplayName}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Supported}" Value="False">
                                        <Setter TargetName="ToolGlyph" Property="Foreground" Value="#808080" />
                                        <Setter TargetName="ToolName" Property="Foreground" Value="#808080" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    </Border>
</Window>
