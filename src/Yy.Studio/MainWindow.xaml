<Window x:Class="Yy.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="易语 Studio"
        Icon="Assets/YyStudio.ico"
        Width="1380"
        Height="860"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewFileCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="N" Modifiers="Control+Alt" Command="{x:Static local:MainWindow.NewProjectCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.NewFormCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenFileCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.OpenFolderCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveFileCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseTabCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="B" Modifiers="Control" Command="{x:Static local:MainWindow.CompileProjectCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RunCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="F5" Modifiers="Control" Command="{x:Static local:MainWindow.RunProjectCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{x:Static local:MainWindow.StopCommand}"
                    xmlns:local="clr-namespace:Yy.Studio" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewFileCommand}" Executed="OnNewFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.NewProjectCommand}" Executed="OnNewProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.NewFormCommand}" Executed="OnNewForm"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFileCommand}" Executed="OnOpenFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFolderCommand}" Executed="OnOpenFolder"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveFileCommand}" Executed="OnSaveFile"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="OnSaveAs"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.CloseTabCommand}" Executed="OnCloseTab"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.CompileProjectCommand}" Executed="OnCompileProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.RunCommand}" Executed="OnRun"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.RunProjectCommand}" Executed="OnRunProject"
                        xmlns:local="clr-namespace:Yy.Studio" />
        <CommandBinding Command="{x:Static local:MainWindow.StopCommand}" Executed="OnStop"
                        xmlns:local="clr-namespace:Yy.Studio" />
    </Window.CommandBindings>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top"
              Height="28"
              Background="{StaticResource PanelRaisedBrush}"
              Foreground="{StaticResource TextBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="6,1">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目…      Ctrl+Alt+N" Command="{x:Static local:MainWindow.NewProjectCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="新建" Command="{x:Static local:MainWindow.NewFileCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="新建窗体" Command="{x:Static local:MainWindow.NewFormCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="打开文件…" Command="{x:Static local:MainWindow.OpenFileCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="打开文件夹…" Command="{x:Static local:MainWindow.OpenFolderCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="保存" Command="{x:Static local:MainWindow.SaveFileCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="另存为…" Command="{x:Static local:MainWindow.SaveAsCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="运行">
                <MenuItem Header="运行项目入口      Ctrl+F5" Command="{x:Static local:MainWindow.RunProjectCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="运行程序      F5" Command="{x:Static local:MainWindow.RunCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
                <MenuItem Header="停止程序      Shift+F5" Command="{x:Static local:MainWindow.StopCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
            </MenuItem>
            <MenuItem Header="生成">
                <MenuItem Header="编译为 EXE      Ctrl+B" Command="{x:Static local:MainWindow.CompileProjectCommand}"
                          xmlns:local="clr-namespace:Yy.Studio" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="语法速查" Click="OnSyntaxClick" />
                <MenuItem Header="关于易语 Studio" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Height="44"
                Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="25" Height="25"
                        CornerRadius="3"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="易"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="易语 Studio" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="中文应用开发环境"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="＋ 新建项目"
                            ToolTip="新建易语项目 (Ctrl+Alt+N)"
                            Command="{x:Static local:MainWindow.NewProjectCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button Style="{StaticResource ToolButton}" Content="打开目录"
                            ToolTip="打开文件或文件夹"
                            Command="{x:Static local:MainWindow.OpenFolderCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button Style="{StaticResource ToolButton}" Content="保存"
                            ToolTip="保存当前文件 (Ctrl+S)"
                            Command="{x:Static local:MainWindow.SaveFileCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button Style="{StaticResource ToolButton}" Content="窗体"
                            ToolTip="新建窗体设计"
                            Command="{x:Static local:MainWindow.NewFormCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button x:Name="CompileProjectButton"
                            Style="{StaticResource ToolButton}"
                            Content="编译"
                            ToolTip="编译项目为独立 EXE (Ctrl+B)"
                            Command="{x:Static local:MainWindow.CompileProjectCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button x:Name="RunButton" Style="{StaticResource RunButton}" Content="▶  启动"
                            ToolTip="运行或预览 (F5)"
                            Command="{x:Static local:MainWindow.RunCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                    <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Content="■  停止"
                            ToolTip="停止运行 (Shift+F5)"
                            IsEnabled="False"
                            Command="{x:Static local:MainWindow.StopCommand}"
                            xmlns:local="clr-namespace:Yy.Studio" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="#007ACC"
                BorderBrush="#0067A8"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="White" />
                    <TextBlock x:Name="StatusText" Text="就绪"
                               Margin="7,0,0,0" FontSize="11"
                               Foreground="White" />
                </StackPanel>
                <TextBlock x:Name="CaretText" Grid.Column="1" Text="行 1，列 1"
                           FontSize="11" Foreground="#EAF6FF"
                           Margin="0,0,18,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="UTF-8  ·  Windows 原生"
                           FontSize="11" Foreground="#EAF6FF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition x:Name="ExplorerColumn" Width="240" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="4" />
                <RowDefinition Height="164" MinHeight="110" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="3" Background="#333337">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="ExplorerActivityButton"
                            Width="44"
                            Height="46"
                            Background="#2D2D30"
                            BorderThickness="0,0,2,0"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="{StaticResource TextBrush}"
                            ToolTip="解决方案资源管理器"
                            Click="OnToggleExplorer">
                        <StackPanel>
                            <TextBlock Text="▱" FontSize="18" HorizontalAlignment="Center" />
                            <TextBlock Text="项目" FontSize="9" HorizontalAlignment="Center"
                                       Foreground="#D7D7D7" Margin="0,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2"
                            Width="44"
                            Height="42"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource MutedBrush}"
                            ToolTip="关于易语 Studio"
                            Click="OnAboutClick">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" x:Name="ExplorerPanel" Grid.RowSpan="3"
                    Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock x:Name="ProjectTitleText" Text="解决方案资源管理器"
                                   Style="{StaticResource SectionTitle}" />
                        <Button Content="+"
                                Style="{StaticResource ToolButton}"
                                Padding="8,2"
                                Margin="0,0,9,4"
                                HorizontalAlignment="Right"
                                ToolTip="新建易语文件"
                                Command="{x:Static local:MainWindow.NewFileCommand}"
                                xmlns:local="clr-namespace:Yy.Studio" />
                    </DockPanel>
                    <TreeView x:Name="ProjectTree"
                              Grid.Row="1"
                              SelectedItemChanged="OnProjectTreeSelectionChanged"
                              MouseDoubleClick="OnProjectTreeDoubleClick" />
                    <Border Grid.Row="2"
                            Margin="12"
                            Padding="10"
                            Background="#1E1E1E"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <StackPanel>
                            <TextBlock Text="源码格式" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text=".ey  ·  UTF-8" FontSize="12" Margin="0,3,0,0" />
                            <TextBlock Text="按 F5 直接运行，无需保存。"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter"
                          Grid.Column="2"
                          Grid.RowSpan="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Grid Grid.Column="3" Background="{StaticResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#2D2D30"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="DocumentTabs"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnDocumentTabSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabChrome"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0,0,0,2"
                                                        Padding="10,0">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Setter TargetName="TabChrome" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="TabChrome" Property="Background" Value="#1E1E1E" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="TabChrome" Property="Background" Value="#3A3D41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   MaxWidth="170"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DirtyMark}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="×"
                                                Tag="{Binding}"
                                                Click="OnCloseTabClick"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{StaticResource MutedBrush}"
                                                Padding="5,0,0,0"
                                                Margin="5,0,0,0"
                                                FontSize="14"
                                                Cursor="Hand"
                                                ToolTip="关闭标签页" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Column="1"
                                Content="+"
                                Style="{StaticResource ToolButton}"
                                Padding="8,3"
                                Margin="5,0"
                                ToolTip="新建源码"
                                Command="{x:Static local:MainWindow.NewFileCommand}"
                                xmlns:local="clr-namespace:Yy.Studio" />
                        <Border Grid.Column="2"
                                Background="#3A3D41"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="3,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="易语 3"
                                       FontSize="9.5"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Grid.Column="3"
                                   Text="Ctrl+Space 补全"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                </Border>

                <avalon:TextEditor x:Name="Editor"
                                   Grid.Row="1"
                                   Background="#1E1E1E"
                                   Foreground="#D4D4D4"
                                   FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="8,10,8,16"
                                   TextChanged="OnEditorTextChanged" />

                <Grid x:Name="DesignerPanel"
                      Grid.Row="1"
                      Background="#1E1E1E"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#2D2D30"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="窗体设计器"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="拖放控件 · Ctrl+单击多选 · 双击按钮生成事件代码"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="DesignerUndoButton"
                                        Content="↶ 撤销"
                                        Style="{StaticResource ToolButton}"
                                        Padding="8,4"
                                        IsEnabled="False"
                                        Click="OnDesignerUndoClick" />
                                <Button x:Name="DesignerRedoButton"
                                        Content="↷ 重做"
                                        Style="{StaticResource ToolButton}"
                                        Padding="8,4"
                                        IsEnabled="False"
                                        Click="OnDesignerRedoClick" />
                                <Button x:Name="DesignerAlignButton"
                                        Content="对齐 ▾"
                                        Style="{StaticResource ToolButton}"
                                        Padding="8,4"
                                        Click="OnDesignerAlignMenuClick">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="左对齐" Tag="Left" Click="OnAlignDesignerControls" />
                                            <MenuItem Header="水平居中对齐" Tag="CenterX" Click="OnAlignDesignerControls" />
                                            <MenuItem Header="右对齐" Tag="Right" Click="OnAlignDesignerControls" />
                                            <Separator />
                                            <MenuItem Header="顶对齐" Tag="Top" Click="OnAlignDesignerControls" />
                                            <MenuItem Header="垂直居中对齐" Tag="CenterY" Click="OnAlignDesignerControls" />
                                            <MenuItem Header="底对齐" Tag="Bottom" Click="OnAlignDesignerControls" />
                                            <Separator />
                                            <MenuItem Header="水平等距分布" Tag="DistributeX" Click="OnAlignDesignerControls" />
                                            <MenuItem Header="垂直等距分布" Tag="DistributeY" Click="OnAlignDesignerControls" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <CheckBox x:Name="SnapCheckBox"
                                          Content="吸附网格"
                                          IsChecked="True"
                                          Foreground="{StaticResource MutedBrush}"
                                          FontSize="11"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <Button Content="代码后置"
                                        Style="{StaticResource ToolButton}"
                                        Padding="10,4"
                                        Click="OnOpenFormCodeBehind" />
                                <Button Content="预览窗体"
                                        Style="{StaticResource ToolButton}"
                                        Padding="10,4"
                                        Click="OnPreviewForm" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="154" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#252526">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="控件"
                                           Style="{StaticResource SectionTitle}" />
                                <ListBox x:Name="ControlToolbox"
                                         Grid.Row="1"
                                         Margin="8,0"
                                         MouseDoubleClick="OnToolboxDoubleClick"
                                         PreviewMouseLeftButtonDown="OnToolboxMouseDown"
                                         PreviewMouseMove="OnToolboxMouseMove">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9,7"
                                                    Margin="0,1"
                                                    Background="#1B222C"
                                                    CornerRadius="5">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2"
                                           Text="双击添加，或拖到画布指定位置。"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="12,8,12,12" />
                            </Grid>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="#3F3F46" />

                        <ScrollViewer Grid.Column="2"
                                      Background="#1E1E1E"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="28">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#2D2D30"
                                    Padding="12"
                                    CornerRadius="8">
                                <Canvas x:Name="DesignerCanvas"
                                        Width="800"
                                        Height="520"
                                        ClipToBounds="True"
                                        AllowDrop="True"
                                        Focusable="True"
                                        SizeChanged="OnDesignerCanvasSizeChanged"
                                        DragOver="OnDesignerCanvasDragOver"
                                        Drop="OnDesignerCanvasDrop"
                                        PreviewMouseLeftButtonDown="OnDesignerCanvasMouseDown"
                                        PreviewMouseMove="OnDesignerCanvasMouseMove"
                                        PreviewMouseLeftButtonUp="OnDesignerCanvasMouseUp"
                                        KeyDown="OnDesignerCanvasKeyDown">
                                    <Canvas.Background>
                                        <DrawingBrush TileMode="Tile"
                                                      Viewport="0,0,16,16"
                                                      ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#F4F7FB">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,16,16" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#E3E9F0">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,16,1" />
                                                                <RectangleGeometry Rect="0,0,1,16" />
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Canvas.Background>
                                </Canvas>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="4"
                          Grid.RowSpan="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="5" Grid.RowSpan="3" Background="{StaticResource PanelBrush}">
                <Grid>
                <TabControl x:Name="InspectorTabs">
                    <TabItem Header="概要">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="当前文件的子程序与入口"
                                       Style="{StaticResource SectionTitle}" />
                            <TreeView x:Name="OutlineTree" Grid.Row="1" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="变量">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="执行完成后的全局变量"
                                       Style="{StaticResource SectionTitle}" />
                            <ListBox x:Name="VariableList" Grid.Row="1" Margin="8,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,5" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="标准库">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="常用内置函数"
                                       Style="{StaticResource SectionTitle}" />
                            <ListBox x:Name="BuiltinList" Grid.Row="1" Margin="8,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,5">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="#72C8FF" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>

                <ScrollViewer x:Name="DesignerInspector"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="13,10,13,18">
                        <TextBlock Text="属性"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,3" />
                        <TextBlock x:Name="PropertyTypeText"
                                   Text="未选择对象"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyNameBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="文本 / 标题" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyTextBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X / 左" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBox x:Name="PropertyXBox"
                                         Margin="0,4,0,0"
                                         Padding="7,5"
                                         Background="#11161D"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="OnDesignerPropertyChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y / 上" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBox x:Name="PropertyYBox"
                                         Margin="0,4,0,0"
                                         Padding="7,5"
                                         Background="#11161D"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="OnDesignerPropertyChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="宽" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBox x:Name="PropertyWidthBox"
                                         Margin="0,4,0,0"
                                         Padding="7,5"
                                         Background="#11161D"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="OnDesignerPropertyChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="高" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                <TextBox x:Name="PropertyHeightBox"
                                         Margin="0,4,0,0"
                                         Padding="7,5"
                                         Background="#11161D"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="OnDesignerPropertyChanged" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="背景色" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyBackgroundBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="前景色" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyForegroundBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="字号" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyFontSizeBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="代码后置文件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyCodeFileBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="单击事件名" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="文本改变事件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyTextChangedEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#1E1E1E"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="选择改变事件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertySelectionChangedEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#1E1E1E"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="选中改变事件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyCheckedChangedEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#1E1E1E"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="窗体载入事件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyLoadEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <TextBlock Text="窗体关闭事件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox x:Name="PropertyCloseEventBox"
                                 Margin="0,4,0,10"
                                 Padding="7,5"
                                 Background="#11161D"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="OnDesignerPropertyChanged" />

                        <CheckBox x:Name="PropertyEnabledCheck"
                                  Content="启用控件"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,2,0,8"
                                  Checked="OnDesignerCheckChanged"
                                  Unchecked="OnDesignerCheckChanged" />
                        <CheckBox x:Name="PropertyVisibleCheck"
                                  Content="设计时可见"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,12"
                                  Checked="OnDesignerCheckChanged"
                                  Unchecked="OnDesignerCheckChanged" />
                        <CheckBox x:Name="PropertyCheckedCheck"
                                  Content="复选框默认选中"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,12"
                                  Checked="OnDesignerCheckChanged"
                                  Unchecked="OnDesignerCheckChanged" />

                        <Button Content="删除所选控件"
                                Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnDeleteDesignerControl" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ShowsPreview="True" />

            <Border Grid.Column="3" Grid.Row="2" Background="#1E1E1E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#131820"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="11,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="运行输出" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="RunInfoText" Margin="10,0,0,0"
                                           FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="清空" Style="{StaticResource ToolButton}"
                                    Padding="8,2" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="OnClearOutput" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="OutputBox"
                             Grid.Row="1"
                             Background="#1E1E1E"
                             Foreground="#B9C6D6"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                             FontSize="12.5"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Padding="12,9"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
