<UserControl x:Class="Yy.Studio.Structured.StructuredCodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FormatTitle"
                               Text="结构化代码"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="2,0,14,0" />
                    <Border x:Name="SourceFormatBadge"
                            Margin="0,0,10,0"
                            Padding="7,3"
                            CornerRadius="2"
                            Background="#264F78"
                            ToolTip=".yyc 是可直接编辑的结构化工程源码">
                        <TextBlock x:Name="SourceFormatText"
                                   Text="YYC"
                                   FontSize="9"
                                   Foreground="#DDEBFA" />
                    </Border>
                    <Button Content="＋ 子程序"
                            Style="{StaticResource PanelButton}"
                            Padding="8,4"
                            Click="OnAddFunction" />
                    <ComboBox x:Name="StatementKindBox"
                              Width="108"
                              Margin="8,0,3,0"
                              Padding="6,3"
                              Background="#1E1E1E"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrush}" />
                    <Button Content="＋ 步骤"
                            Style="{StaticResource PanelButton}"
                            Padding="8,4"
                            Click="OnAddStatement" />
                    <Button Content="删除"
                            Style="{StaticResource PanelButton}"
                            Padding="8,4"
                            Click="OnDelete" />
                    <Button Content="↑"
                            Style="{StaticResource PanelButton}"
                            Padding="9,4"
                            ToolTip="上移"
                            Click="OnMoveUp" />
                    <Button Content="↓"
                            Style="{StaticResource PanelButton}"
                            Padding="9,4"
                            ToolTip="下移"
                            Click="OnMoveDown" />
                </StackPanel>
                <TextBlock x:Name="WorkflowHint"
                           Text="选择容器步骤后添加子步骤；F5 运行，Ctrl+B 编译"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Background="#252526">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="关联窗体"
                               Style="{StaticResource SectionTitle}" />
                    <Border Grid.Row="1"
                            Margin="8,0,8,8"
                            Padding="8,7"
                            Background="#1E1E1E"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="AssociatedFormText"
                                       Text="未关联窗体"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AssociationSummaryText"
                                       Text="独立代码文件"
                                       Margin="0,2,0,6"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="OpenDesignerButton"
                                    Content="打开窗体设计器"
                                    Style="{StaticResource PanelButton}"
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="OnOpenDesigner" />
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="ComponentTree"
                              Grid.Row="2"
                              Margin="6,0,6,8"
                              Padding="2"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              SelectedItemChanged="OnComponentTreeSelectionChanged"
                              ToolTip="事件节点定位代码；双击控件在设计器中定位" />
                    <TextBlock Text="子程序"
                               Grid.Row="3"
                               Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="FunctionList"
                             Grid.Row="4"
                             Margin="6,0"
                             SelectionChanged="OnFunctionSelectionChanged" />
                </Grid>
            </Border>

            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />

            <TreeView x:Name="StatementTree"
                      Grid.Column="2"
                      Padding="14"
                      SelectedItemChanged="OnStatementSelectionChanged" />

            <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}" />

            <Border Grid.Column="4" Background="#252526">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10,12,18">
                        <TextBlock x:Name="InspectorTitle"
                                   Text="程序入口"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InspectorSubtitle"
                                   Text="选择子程序或步骤后编辑参数"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,12" />

                        <StackPanel x:Name="FunctionProperties">
                            <TextBlock Text="子程序名" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="FunctionNameBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnFunctionPropertyChanged" />
                            <TextBlock Text="返回类型" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="ReturnTypeBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnFunctionPropertyChanged" />
                            <TextBlock Text="参数（逗号分隔）" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="ParametersBox"
                                     Margin="0,4,0,4"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="52"
                                     TextChanged="OnFunctionPropertyChanged" />
                        </StackPanel>

                        <StackPanel x:Name="StatementProperties">
                            <StackPanel x:Name="ComponentTargetPanel">
                                <TextBlock Text="从窗体组件选择赋值目标"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" />
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ControlTargetBox"
                                              Padding="6,4"
                                              Background="#1E1E1E"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              SelectionChanged="OnComponentTargetChanged" />
                                    <ComboBox x:Name="PropertyTargetBox"
                                              Grid.Column="2"
                                              Padding="6,4"
                                              Background="#1E1E1E"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              SelectionChanged="OnComponentTargetChanged" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="名称 / 变量" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="NameBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                            <TextBlock Text="类型" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="TypeBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                            <TextBlock Text="目标" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="TargetBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                            <TextBlock Text="值 / 表达式" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="ExpressionBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="52"
                                     TextChanged="OnStatementPropertyChanged" />
                            <TextBlock Text="条件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="ConditionBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="从" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    <TextBox x:Name="FromBox"
                                             Margin="0,4,0,0"
                                             Padding="7,5"
                                             Background="#1E1E1E"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             TextChanged="OnStatementPropertyChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="到" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    <TextBox x:Name="ToBox"
                                             Margin="0,4,0,0"
                                             Padding="7,5"
                                             Background="#1E1E1E"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             TextChanged="OnStatementPropertyChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="步长" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="StepBox"
                                     Margin="0,4,0,10"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                            <TextBlock Text="捕获变量" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBox x:Name="CatchBox"
                                     Margin="0,4,0,4"
                                     Padding="7,5"
                                     Background="#1E1E1E"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="OnStatementPropertyChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
