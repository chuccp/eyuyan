<Window x:Class="Yy.Studio.SystemConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="940"
        Height="640"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#DCE2E8" />
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#3574F0" />
        <SolidColorBrush x:Key="SettingsHoverBrush" Color="#E8EEF7" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#20252B" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#343A40" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>

        <Style x:Key="SettingBox" TargetType="TextBox">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Foreground" Value="#454C55" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DCE8FB" />
                                <Setter Property="Foreground" Value="{StaticResource SettingsAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#C9D1DB" />
        </Style>

        <Style x:Key="PrimaryDialogButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource SettingsAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,0,1"
                Background="#FFFFFF">
            <TextBlock Text="设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="22,0"
                       VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F7F8FA"
                    BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12,0,12">
                    <TextBlock DockPanel.Dock="Top"
                               Text="易语 Studio"
                               Foreground="{StaticResource SettingsMutedBrush}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Margin="20,4,0,10" />
                    <ListBox x:Name="SettingsCategories"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnCategoryChanged">
                        <ListBoxItem Content="编辑器" Tag="Editor" />
                        <ListBoxItem Content="外观与窗体" Tag="Designer" />
                        <ListBoxItem Content="MCP 服务" Tag="Mcp" />
                        <ListBoxItem Content="快捷键" Tag="Shortcuts" />
                        <ListBoxItem Content="配置文件" Tag="Files" />
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="34,24,34,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SectionTitleText"
                           Style="{StaticResource SectionTitle}"
                           Text="编辑器" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="EditorPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="编辑器字号" />
                                <TextBox x:Name="FontSizeBox" Style="{StaticResource SettingBox}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="允许范围 8–28。修改后立即应用到纯代码和易语言代码编辑器。" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="制表宽度" />
                                <TextBox x:Name="TabWidthBox" Style="{StaticResource SettingBox}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="允许范围 1–16。编辑器使用空格代替制表符。" />
                        </StackPanel>

                        <StackPanel x:Name="DesignerPanel" Visibility="Collapsed">
                            <CheckBox x:Name="SnapGridCheck"
                                      Content="窗体设计器启用吸附网格"
                                      Margin="0,4,0,8" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="开启后，移动和缩放控件时默认吸附到 8 像素网格。" />
                        </StackPanel>

                        <StackPanel x:Name="McpPanel" Visibility="Collapsed">
                            <CheckBox x:Name="McpEnabledCheck"
                                      Content="启动 Studio 时启用 MCP 服务"
                                      Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="HTTP 端口" />
                                <TextBox x:Name="McpPortBox" Style="{StaticResource SettingBox}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="允许范围 1024–65535。默认端点：http://127.0.0.1:端口/mcp。" />
                            <CheckBox x:Name="McpAutoPortCheck"
                                      Content="端口被占用时自动寻找后续端口"
                                      Margin="0,4,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="端口尝试次数" />
                                <TextBox x:Name="McpAttemptsBox" Style="{StaticResource SettingBox}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="每行以逗号分隔多个快捷键；留空可停用该动作。支持 Ctrl、Shift、Alt 和 F1–F12。" />
                            <DataGrid x:Name="ShortcutGrid"
                                      Height="390"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      Background="White"
                                      BorderBrush="{StaticResource SettingsBorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="动作"
                                                        Binding="{Binding Name}"
                                                        IsReadOnly="True"
                                                        Width="190" />
                                    <DataGridTextColumn Header="快捷键"
                                                        Binding="{Binding Gestures, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel x:Name="FilesPanel" Visibility="Collapsed">
                            <CheckBox x:Name="ShowNewProgramDialogCheck"
                                      Content="启动时显示新建程序对话框"
                                      Margin="0,4,0,12" />
                            <TextBlock Text="Studio 配置文件"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,8" />
                            <TextBox x:Name="ConfigPathBox"
                                     IsReadOnly="True"
                                     Height="32"
                                     Padding="7,4"
                                     Background="#F7F8FA" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Text="用户配置优先于安装目录中的便携配置。修改 MCP 端口或快捷键后需要重启 Studio 才能刷新服务与输入绑定。" />
                            <Button Content="打开配置文件"
                                    Style="{StaticResource DialogButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Click="OnOpenConfigClick" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#F7F8FA"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="ValidationText"
                           Foreground="#C42B1C"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="应用"
                            Style="{StaticResource DialogButton}"
                            Click="OnApplyClick" />
                    <Button Content="取消"
                            Style="{StaticResource DialogButton}"
                            IsCancel="True" />
                    <Button Content="确定"
                            Style="{StaticResource PrimaryDialogButton}"
                            IsDefault="True"
                            Click="OnOkClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
