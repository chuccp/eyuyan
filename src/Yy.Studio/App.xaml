<Application x:Class="Yy.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <!-- 经典 Windows 配色(对齐易语言官方界面)。键名保持不变,既有引用不受影响。 -->
        <SolidColorBrush x:Key="WindowBrush" Color="#D4D0C8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#D4D0C8" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#ECE9D8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#808080" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E6E6E" />
        <SolidColorBrush x:Key="TextBrush" Color="#000000" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0A246A" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#316AC5" />
        <SolidColorBrush x:Key="WarningBrush" Color="#808000" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#A00000" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#006000" />

        <!-- 经典主题附加刷 -->
        <SolidColorBrush x:Key="FaceBrush" Color="#ECE9D8" />
        <SolidColorBrush x:Key="SunkenShadowBrush" Color="#808080" />
        <SolidColorBrush x:Key="SunkenDarkBrush" Color="#404040" />
        <SolidColorBrush x:Key="SunkenLightBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HintBrush" Color="#C0D8F0" />
        <SolidColorBrush x:Key="EditorBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#808080" />
        <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolTipBrush" Color="#FFFFE1" />

        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Classic.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
