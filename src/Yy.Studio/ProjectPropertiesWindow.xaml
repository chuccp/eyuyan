<Window x:Class="Yy.Studio.ProjectPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目属性"
        Width="620"
        Height="570"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="项目属性" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="项目清单 .yyproj"
                           Margin="10,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18">
                <TextBlock Text="项目名称" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="ProjectNameBox"
                         Margin="0,5,0,14"
                         Padding="8,6"
                         Background="#1E1E1E"
                         BorderBrush="{StaticResource BorderBrush}" />

                <TextBlock Text="包名" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="PackageNameBox"
                         Margin="0,5,0,14"
                         Padding="8,6"
                         Background="#1E1E1E"
                         BorderBrush="{StaticResource BorderBrush}" />

                <TextBlock Text="项目文件" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="ProjectPathBox"
                         Margin="0,5,0,14"
                         Padding="8,6"
                         IsReadOnly="True"
                         Background="#252526"
                         Foreground="{StaticResource MutedBrush}"
                         BorderBrush="{StaticResource BorderBrush}" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="源码目录" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox Text="Sources/"
                                 Margin="0,5,0,0"
                                 Padding="8,6"
                                 IsReadOnly="True"
                                 Background="#252526"
                                 Foreground="{StaticResource MutedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="资源目录" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <TextBox Text="Resources/"
                                 Margin="0,5,0,0"
                                 Padding="8,6"
                                 IsReadOnly="True"
                                 Background="#252526"
                                 Foreground="{StaticResource MutedBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="入口源码" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <ComboBox x:Name="EntrySourceBox"
                                  Margin="0,5,0,14"
                                  Padding="7,5"
                                  Background="#1E1E1E"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="启动窗体" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <ComboBox x:Name="StartupFormBox"
                                  Margin="0,5,0,14"
                                  Padding="7,5"
                                  IsEditable="True"
                                  Background="#1E1E1E"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="输出文件名" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBox x:Name="OutputNameBox"
                         Margin="0,5,0,14"
                         Padding="8,6"
                         Background="#1E1E1E"
                         BorderBrush="{StaticResource BorderBrush}" />

                <Border Background="#252526"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,10"
                        Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ProjectSummaryText"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#2D2D30"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <Button Content="取消"
                        Style="{StaticResource PanelButton}"
                        Padding="18,6"
                        Click="OnCancel" />
                <Button Content="保存"
                        Style="{StaticResource RunButton}"
                        Padding="20,6"
                        Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
