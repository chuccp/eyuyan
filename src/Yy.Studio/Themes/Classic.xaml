<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 经典 Windows 外观(对齐易语言官方界面)。刷键定义在 App.xaml,此处一律 DynamicResource 引用。 -->

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Tahoma" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>

    <!-- 工具条按钮:平时无边框,悬停凸起,按下凹陷 -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D4D0C8" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#ECE9D8" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#808080" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080" />
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Background" Value="{DynamicResource FaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
    </Style>

    <!-- 经典凸起按钮(3D 边) -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource FaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource SunkenDarkBrush}"
                            BorderThickness="1">
                        <Border x:Name="Inner"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SunkenLightBrush}"
                                BorderThickness="1,1,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="#ECE9D8" />
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource SunkenLightBrush}" />
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource SunkenDarkBrush}" />
                            <Setter TargetName="Inner" Property="BorderThickness" Value="0,0,1,1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SunkenShadowBrush}" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,10,12,6" />
    </Style>

    <!-- 弹出菜单项(经典蓝高亮);模板必须带 PART_Popup,否则带子项的菜单无法展开 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Margin="1,1"
                                Padding="6,3"
                                Background="Transparent"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#404040"
                                           FontSize="11"
                                           Margin="22,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SubmenuArrow"
                                           Grid.Column="3"
                                           Text="►"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="9"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="False"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=ItemBorder}"
                               HorizontalOffset="-3"
                               StaysOpen="False">
                            <Border MinWidth="160"
                                    Background="{DynamicResource FaceBrush}"
                                    BorderBrush="{DynamicResource SunkenDarkBrush}"
                                    BorderThickness="1">
                                <Border BorderBrush="{DynamicResource SunkenLightBrush}"
                                        BorderThickness="1,1,0,0"
                                        Padding="2,3">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}" />
                            <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{DynamicResource HighlightTextBrush}" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SunkenShadowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶级菜单头 -->
    <Style x:Key="TopMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="TopHeader"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="False"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=TopHeader}"
                               StaysOpen="False">
                            <Border MinWidth="240"
                                    Background="{DynamicResource FaceBrush}"
                                    BorderBrush="{DynamicResource SunkenDarkBrush}"
                                    BorderThickness="1">
                                <Border BorderBrush="{DynamicResource SunkenLightBrush}"
                                        BorderThickness="1,1,0,0"
                                        Padding="2,3">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="TopHeader" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="TopHeader" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource FaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,3" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <!-- 经典黄底提示 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ToolTipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,3" />
    </Style>

    <!-- 蚀刻分隔线 -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Height="2" Margin="2,3">
                        <Rectangle VerticalAlignment="Top" Height="1" Fill="{DynamicResource SunkenShadowBrush}" />
                        <Rectangle VerticalAlignment="Top" Margin="0,1" Height="1" Fill="{DynamicResource SunkenLightBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <!-- 经典树项:+/− 方框展开符、蓝底白字选中 -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="1,1">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="Exp"
                                              Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="13"
                                              Height="13"
                                              Margin="0,1,3,1"
                                              VerticalAlignment="Center">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Box"
                                                    Background="{DynamicResource EditorBrush}"
                                                    BorderBrush="{DynamicResource SunkenShadowBrush}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="Glyph"
                                                           Text="+"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           Margin="0,-2,0,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="&#8722;" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ItemsPresenter x:Name="Items"
                                        Grid.Row="1"
                                        Margin="14,0,0,0"
                                        Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Items" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Exp" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SunkenShadowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 经典夹标签:矩形 3D 边,支持标签条在上/在下 -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabFace"
                            Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource SunkenShadowBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}"
                            Margin="2,2,2,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource FaceBrush}" />
                            <Setter TargetName="TabFace" Property="BorderThickness" Value="1,1,1,1" />
                            <Setter TargetName="TabFace" Property="Margin" Value="2,2,2,-1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource SunkenDarkBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                     Value="Bottom">
                            <Setter TargetName="TabFace" Property="BorderThickness" Value="1,0,1,1" />
                            <Setter TargetName="TabFace" Property="Margin" Value="2,0,2,2" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                           Value="Bottom" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="TabFace" Property="BorderThickness" Value="1,1,1,1" />
                            <Setter TargetName="TabFace" Property="Margin" Value="2,-1,2,2" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 经典输入框:白底黑字、下陷边 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,2" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>

    <!-- 可复用面板样式 -->
    <Style x:Key="ClassicSunkenBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ClassicRaisedBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ClassicToolbar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    </Style>

    <Style x:Key="ClassicTableHeaderCell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,2" />
    </Style>

    <Style x:Key="ClassicTableBodyCell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SunkenShadowBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="4,1" />
    </Style>

</ResourceDictionary>
