<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yy.Studio.Avalonia.MainWindow"
        Title="易语 Studio"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#E8EAED"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        KeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing"
        Closed="OnWindowClosed"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnWindowDragOver"
        DragDrop.Drop="OnWindowDrop">
  <DockPanel LastChildFill="True">

    <!-- 自定义顶栏:应用图标、主菜单、文档标题、布局入口与窗口按钮共用一条操作栏 -->
    <!-- 顶栏无底部分隔线(参考:BorderThickness=0,靠色差区分) -->
    <Border x:Name="WindowTitleBar"
            DockPanel.Dock="Top"
            Height="38"
            Background="#F7F7F8"
            BorderThickness="0">
      <Grid ColumnDefinitions="40,Auto,*,Auto">
        <Border Grid.Column="0"
                Width="40"
                Height="38"
                Background="Transparent"
                Focusable="False"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
          <Border Width="22" Height="22"
                  Background="#238B55"
                  CornerRadius="5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <TextBlock Text="易"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Border>
        <Menu x:Name="MainMenu"
              Grid.Column="1"
              Background="Transparent"
              Padding="2,0"
              VerticalAlignment="Center"
              FontSize="12">
          <MenuItem Header="_F程序">
            <MenuItem Header="新建工程…" Click="OnNewProject" />
            <MenuItem Header="新建程序…" Click="OnNewProgram" />
            <MenuItem Header="导入老程序(.e)…" Click="OnImportLegacy" />
            <Separator />
            <MenuItem Header="打开工程…" Click="OnOpenProject" />
            <MenuItem Header="打开文件…" InputGesture="Ctrl+O" Click="OnOpenFile" />
            <MenuItem Header="打开文件夹…" InputGesture="Ctrl+Shift+O" Click="OnOpenFolder" />
            <MenuItem Header="重新加载工程" Click="OnReloadProject" />
            <Separator />
            <MenuItem Header="保存" InputGesture="Ctrl+S" Click="OnSaveCurrent" />
            <MenuItem Header="另存为…" InputGesture="Ctrl+Shift+S" Click="OnSaveAs" />
            <MenuItem Header="保存全部" Click="OnSaveAll" />
            <MenuItem Header="关闭标签" InputGesture="Ctrl+W" Click="OnCloseCurrent" />
            <Separator />
            <MenuItem Header="系统配置" Click="OnSystemConfig" />
            <MenuItem Header="打开 Studio 配置文件" Click="OnOpenStudioConfig" />
            <MenuItem Header="易模块管理" Click="OnModuleManager" />
            <MenuItem Header="程序配置" Click="OnProjectProperties" />
            <Separator />
            <MenuItem Header="退出" InputGesture="Alt+F4" Click="OnExit" />
          </MenuItem>
          <MenuItem Header="_E编辑">
            <MenuItem Header="撤销" InputGesture="Ctrl+Z" Click="OnEditUndo" />
            <MenuItem Header="重做" InputGesture="Ctrl+Y" Click="OnEditRedo" />
            <Separator />
            <MenuItem Header="剪切" InputGesture="Ctrl+X" Click="OnEditCut" />
            <MenuItem Header="复制" InputGesture="Ctrl+C" Click="OnEditCopy" />
            <MenuItem Header="粘贴" InputGesture="Ctrl+V" Click="OnEditPaste" />
            <MenuItem Header="全选" InputGesture="Ctrl+A" Click="OnEditSelectAll" />
            <Separator />
            <MenuItem Header="格式化代码" Click="OnFormatCode" />
          </MenuItem>
          <MenuItem Header="_V查看">
            <MenuItem x:Name="ToggleStatusBarMenuItem"
                      Header="状态栏"
                      ToggleType="CheckBox"
                      IsChecked="True"
                      Click="OnToggleStatusBar" />
            <Separator />
            <MenuItem Header="工具窗口">
              <MenuItem Header="项目" InputGesture="Alt+1" Click="OnToggleProjectWindow" />
              <MenuItem Header="程序与属性" InputGesture="Alt+2" Click="OnToggleWorkWindow" />
              <MenuItem Header="控制台" InputGesture="Alt+4" Click="OnToggleConsoleWindow" />
            </MenuItem>
            <MenuItem Header="布局">
              <MenuItem Header="默认布局" Click="OnLayoutPreset" Tag="默认" />
              <MenuItem Header="专注代码" Click="OnLayoutPreset" Tag="专注代码" />
              <MenuItem Header="窗体设计" Click="OnLayoutPreset" Tag="窗体设计" />
            </MenuItem>
            <Separator />
            <MenuItem Header="全局变量表" Click="OnOpenDataTable" Tag="全局变量" />
            <MenuItem Header="常量表" Click="OnOpenDataTable" Tag="常量表" />
            <MenuItem Header="资源表" Click="OnOpenDataTable" Tag="资源表" />
            <Separator />
            <MenuItem Header="预览被设计窗口" InputGesture="Ctrl+Enter" Click="OnPreviewForm" />
          </MenuItem>
          <MenuItem Header="_I插入">
            <MenuItem Header="新窗口" Click="OnNewForm" />
            <MenuItem Header="新建源码" Click="OnNewSource" />
            <MenuItem Header="新子程序" Click="OnInsertSubprogram" />
            <MenuItem Header="新资源">
              <MenuItem Header="图片" Click="OnAddImageResource" />
              <MenuItem Header="声音" Click="OnAddSoundResource" />
            </MenuItem>
            <Separator />
            <MenuItem Header="全局变量表" Click="OnOpenDataTable" Tag="全局变量" />
            <MenuItem Header="常量表" Click="OnOpenDataTable" Tag="常量表" />
            <MenuItem Header="资源表" Click="OnOpenDataTable" Tag="资源表" />
          </MenuItem>
          <MenuItem Header="_B数据库">
            <MenuItem Header="数据库设计器" Click="OnDatabaseDesigner" />
            <MenuItem Header="数据绑定" Click="OnDataBind" />
          </MenuItem>
          <MenuItem Header="_R运行">
            <MenuItem x:Name="MenuRunItem" Header="运行" InputGesture="F5" Click="OnRunProject" />
            <MenuItem Header="运行项目" InputGesture="Ctrl+F5" Click="OnRunProject" />
            <MenuItem x:Name="MenuStopItem" Header="终止运行" InputGesture="Shift+F5" Click="OnStopProgram" />
            <Separator />
            <MenuItem Header="单步" InputGesture="F8" Click="OnDebugStep" />
            <MenuItem Header="单步跳过" InputGesture="F10" Click="OnDebugStepOver" />
            <MenuItem Header="跳出" InputGesture="Shift+F8" Click="OnDebugStepOut" />
            <MenuItem Header="到光标处" InputGesture="F4" Click="OnDebugRunToLine" />
            <Separator />
            <MenuItem Header="切换断点" InputGesture="F9" Click="OnDebugToggleBreakpoint" />
          </MenuItem>
          <MenuItem Header="_C编译">
            <MenuItem x:Name="MenuBuildItem" Header="编译原生 EXE" InputGesture="F7" Click="OnBuildProject" />
            <MenuItem x:Name="MenuCheckItem" Header="检查" Click="OnCheckProject" />
            <Separator />
            <MenuItem x:Name="TargetPlatformMenu" Header="目标平台">
              <MenuItem Header="auto" Tag="auto" ToggleType="CheckBox" Click="OnTargetPlatformClick" />
              <MenuItem Header="windows-x64" Tag="windows-x64" ToggleType="CheckBox" Click="OnTargetPlatformClick" />
              <MenuItem Header="macos-arm64" Tag="macos-arm64" ToggleType="CheckBox" Click="OnTargetPlatformClick" />
              <MenuItem Header="macos-x64" Tag="macos-x64" ToggleType="CheckBox" Click="OnTargetPlatformClick" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_T工具">
            <MenuItem Header="易语开发文档" InputGesture="F1" Click="OnDocumentation" />
            <Separator />
            <MenuItem Header="程序配置" Click="OnProjectProperties" />
            <MenuItem Header="系统配置" Click="OnSystemConfig" />
          </MenuItem>
          <MenuItem x:Name="WindowMenu" Header="_W窗口" />
          <MenuItem Header="_H帮助">
            <MenuItem Header="易语开发文档" Click="OnDocumentation" />
            <Separator />
            <MenuItem Header="关于易语 Studio" Click="OnAbout" />
          </MenuItem>
        </Menu>
        <Border Grid.Column="2"
                Background="Transparent"
                Padding="18,0"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
          <TextBlock x:Name="TitleDocumentText"
                     Text="易语 Studio"
                     Foreground="#6F737A"
                     FontSize="11.5"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </Border>
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="0">
          <Button x:Name="LayoutButton"
                  Classes="topbar"
                  Click="OnLayoutButtonClick"
                  ToolTip.Tip="配置工具窗口和窗口布局">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▦" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="布局" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Height="18" Margin="0,10,3,10" Background="#D8DBDF" />
          <Button Classes="caption" Click="OnMinimizeWindow" ToolTip.Tip="最小化">
            <Rectangle Width="10" Height="1" Fill="#4B5563"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="CaptionMaximizeButton" Classes="caption" Click="OnMaximizeRestoreWindow" ToolTip.Tip="最大化">
            <Grid Width="12" Height="12">
              <Rectangle x:Name="CaptionMaximizeIcon" Width="10" Height="10"
                         Stroke="#4B5563" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Canvas x:Name="CaptionRestoreIcon" Width="12" Height="12" IsVisible="False">
                <Rectangle Canvas.Left="3" Canvas.Top="0" Width="8" Height="8"
                           Stroke="#4B5563" StrokeThickness="1" />
                <Rectangle Canvas.Left="0" Canvas.Top="3" Width="8" Height="8"
                           Fill="#F7F7F8" Stroke="#4B5563" StrokeThickness="1" />
              </Canvas>
            </Grid>
          </Button>
          <Button Classes="caption close" Click="OnCloseWindow" ToolTip.Tip="关闭">
            <Path x:Name="CaptionGlyph" Width="10" Height="10"
                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                  Stroke="#4B5563" StrokeThickness="1.2"
                  Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态条:实际 MCP 地址可点击复制 -->
    <Border x:Name="StatusBarRow"
            DockPanel.Dock="Bottom"
            Height="22"
            Background="#F7F7F8">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#4ADE80" />
          <TextBlock x:Name="StatusText"
                     Text="就绪"
                     Margin="7,0,0,0"
                     FontSize="11"
                     Foreground="#1F2328"
                     VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="McpEndpointButton"
                Grid.Column="1"
                Content="MCP 未启用"
                Margin="0,0,12,0"
                Padding="7,1"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="2"
                Foreground="#6F737A"
                FontSize="10.5"
                Cursor="Hand"
                ToolTip.Tip="点击复制 MCP HTTP 地址"
                Click="OnCopyMcpEndpoint" />
        <TextBlock x:Name="CaretText"
                   Grid.Column="2"
                   Text="行 1，列 1"
                   FontSize="11"
                   Foreground="#1F2328"
                   Margin="0,0,18,0"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="PlatformStatusText"
                   Grid.Column="3"
                   Text="UTF-8 · Windows 原生"
                   FontSize="11"
                   Foreground="#6F737A"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 构建目标选择(隐藏;菜单“编译 → 目标平台”驱动) -->
    <ComboBox x:Name="TargetBox" IsVisible="False" DockPanel.Dock="Top" />

    <!-- 一体式工作台:左右快捷轨 + 停靠工具窗 -->
    <Grid x:Name="SideActionShell" ColumnDefinitions="34,*,34">
      <Border Grid.Column="0"
              Background="#F7F7F8"
              BorderThickness="0">
        <DockPanel Margin="0,6">
          <StackPanel DockPanel.Dock="Top">
            <Button Classes="rail" Content="▶" Foreground="#238B55"
                    ToolTip.Tip="运行 (F5)" Click="OnRunProject" />
            <Button x:Name="RailRunProjectButton" Classes="rail" Content="▶▶" FontSize="11"
                    ToolTip.Tip="运行项目 (Ctrl+F5)" Click="OnRunProject" />
            <Button x:Name="RailStopButton" Classes="rail" Content="■" Foreground="#C94F4F"
                    ToolTip.Tip="停止运行 (Shift+F5)" Click="OnStopProgram" />
            <Border Width="18" Height="1" Margin="0,5" Background="#D5D8DC" HorizontalAlignment="Center" />
            <Button x:Name="RailBuildButton" Classes="rail" Content="⚒"
                    ToolTip.Tip="编译为 EXE (Ctrl+B)" Click="OnBuildProject" />
            <Button Classes="rail" Content="●" Foreground="#C94F4F"
                    ToolTip.Tip="切换断点 (F9)" Click="OnDebugToggleBreakpoint" />
            <Border Width="18" Height="1" Margin="0,5" Background="#D5D8DC" HorizontalAlignment="Center" />
            <Button Classes="rail" Content="▤"
                    ToolTip.Tip="显示或隐藏项目工具窗口 (Alt+1)" Click="OnToggleProjectWindow" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Classes="rail" Content="⌘"
                    ToolTip.Tip="Studio 设置" Click="OnSystemConfig" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="ToolWindowHost" Grid.Column="1"
              Background="#F7F7F8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="180" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="360" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="4" />
          <RowDefinition Height="172" MinHeight="96" />
        </Grid.RowDefinitions>

        <!-- 左:项目目录 -->
        <Border x:Name="ProjectPanel"
                Grid.Column="0" Grid.Row="0"
                Margin="6,4,1,1"
                Classes="toolWindow">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="toolHeader">
              <TextBlock Text="项目"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="#1F2328" />
            </Border>
            <TreeView x:Name="ProjectTree"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="4"
                      DoubleTapped="OnProjectTreeDoubleTapped">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Icon}" Foreground="#6F737A" FontSize="11" />
                    <TextBlock Text="{Binding Name}" Padding="0,1" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="打开" Click="OnOpenSelectedNode" />
                  <MenuItem Header="保存" Click="OnSaveCurrent" />
                  <Separator />
                  <MenuItem Header="复制路径" Click="OnCopySelectedNodePath" />
                  <MenuItem Header="在文件管理器中显示" Click="OnRevealSelectedNode" />
                  <Separator />
                  <MenuItem Header="刷新工程" Click="OnReloadProject" />
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
          </DockPanel>
        </Border>

        <GridSplitter x:Name="ProjectSplitter"
                      Grid.Column="1" Grid.Row="0"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <!-- 中:编辑区 -->
        <Border x:Name="EditorPanel"
                Grid.Column="2" Grid.Row="0"
                Margin="1,4,1,1"
                Classes="toolWindow">
          <Grid>
            <TabControl x:Name="DocumentTabs"
                        Background="Transparent"
                        Padding="0" />
            <TextBlock Text="F1 帮助 · Ctrl+Space 补全"
                       FontSize="10"
                       Foreground="#6F737A"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,10,12,0"
                       IsHitTestVisible="False" />
          </Grid>
        </Border>

        <GridSplitter x:Name="WorkSplitter"
                      Grid.Column="3" Grid.Row="0"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <!-- 右:程序数据、属性 -->
        <Border x:Name="WorkPanel"
                Grid.Column="4" Grid.Row="0"
                Margin="1,4,6,1"
                Classes="toolWindow">
          <TabControl x:Name="WorkTabs">
            <TabItem Header="程序">
              <DockPanel>
                <Border DockPanel.Dock="Top" Classes="toolHeader">
                  <TextBlock Text="程序数据"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#1F2328" />
                </Border>
                <TreeView x:Name="ProgramOutline"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="6,1,6,6"
                          DoubleTapped="OnWorkTreeDoubleTapped">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Icon}" Foreground="#6F737A" FontSize="11" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </TabItem>
            <TabItem Header="属性">
              <ScrollViewer>
                <ContentControl x:Name="WorkPropertyHost">
                  <StackPanel Margin="12,10" Spacing="8">
                    <TextBlock Text="属性"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#1F2328" />
                    <TextBlock x:Name="PropertySummary"
                               Text="选择代码、窗体或控件后显示摘要。"
                               TextWrapping="Wrap"
                               FontSize="11.5"
                               Foreground="#6F737A" />
                  </StackPanel>
                </ContentControl>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter x:Name="ConsoleSplitter"
                      Grid.ColumnSpan="5" Grid.Row="1"
                      Background="Transparent"
                      ResizeDirection="Rows" />

        <!-- 底:提示与输出组合夹 -->
        <Border x:Name="ConsolePanel"
                Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="2"
                Margin="6,1,6,6"
                Classes="toolWindow">
          <TabControl x:Name="BottomTabs" Padding="0">
            <TabItem Header="提示">
              <TextBox x:Name="EditorHelpBox"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Background="#FFFFFF"
                       BorderThickness="0"
                       FontSize="12"
                       Padding="10,6"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="控制台">
              <DockPanel>
                <Button DockPanel.Dock="Top"
                        Content="清空"
                        Click="OnClearConsole"
                        HorizontalAlignment="Right"
                        Padding="10,2"
                        Margin="0,4,8,4" />
                <TextBox x:Name="ConsoleText"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                         FontSize="12"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="12,4,12,8"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <TextBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="复制" InputGesture="Ctrl+C" Click="OnConsoleCopy" />
                      <MenuItem Header="全选" InputGesture="Ctrl+A" Click="OnConsoleSelectAll" />
                      <Separator />
                      <MenuItem Header="清空控制台" Click="OnClearConsole" />
                    </ContextMenu>
                  </TextBox.ContextMenu>
                </TextBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="调用表">
              <ListBox x:Name="CallStackList" Background="Transparent" BorderThickness="0" />
            </TabItem>
            <TabItem Header="监视表">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
                  <TextBox x:Name="WatchInputBox" Width="220" Watermark="变量名" />
                  <Button Content="加入监视" Click="OnAddWatch" />
                  <Button Content="移除" Click="OnRemoveWatch" />
                </StackPanel>
                <ListBox x:Name="WatchList" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text=" = " FontSize="12" />
                        <TextBlock Text="{Binding Value}" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
            <TabItem Header="变量表">
              <ListBox x:Name="VariableList" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text=" = " FontSize="12" />
                        <TextBlock Text="{Binding Value}" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="搜寻1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
                  <TextBox x:Name="SearchInputBox" Width="240" Watermark="在当前文档中搜寻" />
                  <Button Content="搜寻" Click="OnSearch" />
                </StackPanel>
                <ListBox x:Name="SearchResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         DoubleTapped="OnSearchResultDoubleTapped" />
              </DockPanel>
            </TabItem>
            <TabItem Header="搜寻2">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
                  <TextBox x:Name="SearchInputBox2" Width="240" Watermark="第二组搜寻结果" />
                  <Button Content="搜寻" Click="OnSearch2" />
                </StackPanel>
                <ListBox x:Name="SearchResultsList2"
                         Background="Transparent"
                         BorderThickness="0"
                         DoubleTapped="OnSearchResult2DoubleTapped" />
              </DockPanel>
            </TabItem>
            <TabItem Header="剪辑历史">
              <ListBox x:Name="ClipHistoryList"
                       Background="Transparent"
                       BorderThickness="0"
                       DoubleTapped="OnClipHistoryInsert" />
            </TabItem>
          </TabControl>
        </Border>
      </Grid>

      <!-- 右快捷轨 -->
      <Border Grid.Column="2"
              Background="#F7F7F8"
              BorderThickness="0">
        <DockPanel Margin="0,6">
          <StackPanel DockPanel.Dock="Top">
            <Button Classes="rail" Content="◫"
                    ToolTip.Tip="显示或隐藏程序/属性工具窗口 (Alt+2)" Click="OnToggleWorkWindow" />
            <Button Classes="rail" Content="⌨"
                    ToolTip.Tip="显示控制台 (Alt+4)" Click="OnToggleConsoleWindow" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Classes="rail" Content="M" FontFamily="Cascadia Code,Consolas,monospace"
                    FontSize="12" FontWeight="SemiBold"
                    ToolTip.Tip="复制实际 MCP HTTP 地址" Click="OnCopyMcpEndpoint" />
            <Button Classes="rail" Content="?" FontSize="14" FontWeight="SemiBold"
                    ToolTip.Tip="打开易语开发文档 (F1)" Click="OnDocumentation" />
            <Border Width="18" Height="1" Margin="0,5" Background="#D5D8DC" HorizontalAlignment="Center" />
            <Button Classes="rail" Content="⚙"
                    ToolTip.Tip="Studio 设置" Click="OnSystemConfig" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
