<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:Yy.Studio.Avalonia.Features.Forms"
             x:Class="Yy.Studio.Avalonia.Features.Forms.FormDesignerView"
             Background="#FFFFFF">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,300">
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="#F4F7FB" BorderBrush="#DDE4EC" BorderThickness="0,0,0,1"
            Padding="10,6">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <WrapPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Margin" Value="0,0,6,3" />
          </Style>
        </WrapPanel.Styles>
        <TextBlock Text="组件" VerticalAlignment="Center" Foreground="#37475A"
                   Margin="0,0,6,3" />
        <ComboBox x:Name="ToolboxCombo" Width="150" Margin="0,0,6,3" />
        <Button Content="添加控件" Padding="10,4" Click="OnAddControlClick" />
        <Button Content="删除" Padding="10,4" Click="OnDeleteClick" />
        <Button Content="置前" Padding="10,4" Click="OnBringFrontClick" />
        <Button Content="置后" Padding="10,4" Click="OnSendBackClick" />
        <Button Content="左对齐" Padding="10,4" Click="OnAlignLeftClick" />
        <Button Content="顶对齐" Padding="10,4" Click="OnAlignTopClick" />
        <Button Content="水平均分" Padding="10,4" Click="OnDistributeHorizontalClick" />
        <Button Content="垂直均分" Padding="10,4" Click="OnDistributeVerticalClick" />
        <CheckBox x:Name="SnapCheckBox" Content="网格吸附" IsChecked="True"
                  Click="OnSnapClick" VerticalAlignment="Center" Margin="0,0,6,3" />
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#E8EDF3" ClipToBounds="True">
      <ScrollViewer x:Name="CanvasScrollViewer"
                    Background="#E8EDF3"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <Border Padding="24" Background="Transparent">
          <Grid x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top">
            <forms:DesignerSurface x:Name="GridSurface" IsHitTestVisible="False" />
            <Canvas x:Name="DesignerCanvas" Focusable="True" Background="Transparent" />
            <forms:DesignerSelectionOverlay x:Name="SelectionOverlay" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </ScrollViewer>
    </Border>

    <Border x:Name="DesignerPropertyPanel"
            Grid.Row="1" Grid.Column="1"
            Background="#FBFCFE" BorderBrush="#DDE4EC" BorderThickness="1,0,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Spacing="8">
          <TextBlock Text="属性" FontWeight="SemiBold" Foreground="#17212B" />
          <ComboBox x:Name="PropertyObjectCombo" HorizontalAlignment="Stretch"
                    SelectionChanged="OnPropertyObjectChanged" />
          <ComboBox x:Name="EventSelectorCombo" HorizontalAlignment="Stretch"
                    SelectionChanged="OnEventSelectorChanged" />
          <Border Height="1" Background="#E1E7EE" Margin="0,2" />
          <StackPanel x:Name="PropertyRowsHost" Spacing="4" />
          <TextBlock x:Name="PropertyHintText" TextWrapping="Wrap" FontSize="11"
                     Foreground="#66778B" Margin="0,4,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="2"
            Background="#F1F5F9" BorderBrush="#DBE2EA" BorderThickness="0,1,0,0"
            Padding="10,4">
      <TextBlock x:Name="StatusText" Text="选择控件后可拖动、缩放或编辑属性。"
                 FontSize="11" Foreground="#66778B"
                 TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
