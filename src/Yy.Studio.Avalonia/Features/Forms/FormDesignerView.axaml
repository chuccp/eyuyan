<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:Yy.Studio.Avalonia.Features.Forms"
             x:Class="Yy.Studio.Avalonia.Features.Forms.FormDesignerView"
             Background="#FFFFFF">
  <!-- 中间画布 | 属性夹(移交宿主后收起) | 组件箱(仅设计器显示) -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,300,132">

    <Border Grid.Row="0" Grid.Column="0" Background="#E8EDF3" ClipToBounds="True">
      <ScrollViewer x:Name="CanvasScrollViewer"
                    Background="#E8EDF3"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top">
          <!-- 设计期窗框:官方样式蓝渐变标题栏(随画布滚动,不参与控件坐标系) -->
          <Border x:Name="TitleChrome"
                  Height="28"
                  VerticalAlignment="Top"
                  BorderBrush="#000000"
                  BorderThickness="1,1,1,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#0A246A" Offset="0" />
                <GradientStop Color="#316AC5" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="10,0,4,0">
              <TextBlock x:Name="TitleChromeText"
                         Text=""
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Spacing="2">
                <Border Width="12" Height="12" Background="Transparent">
                  <Rectangle Width="8" Height="1" Fill="White"
                             VerticalAlignment="Bottom" />
                </Border>
                <Border Width="12" Height="12" Background="Transparent">
                  <Rectangle Width="8" Height="8"
                             Stroke="White" StrokeThickness="1"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="14" Height="12"
                        Background="#C0392B"
                        BorderBrush="#E8746B"
                        BorderThickness="1">
                  <TextBlock Text="×"
                             Foreground="White"
                             FontSize="11"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>
          <forms:DesignerSurface x:Name="GridSurface" Margin="0,28,0,0" IsHitTestVisible="False" />
          <Canvas x:Name="DesignerCanvas" Margin="0,28,0,0" Focusable="True" Background="Transparent" />
          <forms:DesignerSelectionOverlay x:Name="SelectionOverlay" Margin="0,28,0,0" IsHitTestVisible="False" />
        </Grid>
      </ScrollViewer>
    </Border>

    <Border x:Name="DesignerPropertyPanel"
            Grid.Row="0" Grid.Column="1"
            Background="#FFFFFF"
            BorderBrush="#D8DBDF"
            BorderThickness="1,0,0,0"
            Padding="8,6">
      <DockPanel>
        <ComboBox x:Name="PropertyObjectCombo" HorizontalAlignment="Stretch"
                  DockPanel.Dock="Top"
                  SelectionChanged="OnPropertyObjectChanged" />
        <ComboBox x:Name="EventSelectorCombo" HorizontalAlignment="Stretch"
                  DockPanel.Dock="Top" Margin="0,4,0,4"
                  SelectionChanged="OnEventSelectorChanged" />
        <TextBlock x:Name="PropertyHintText" DockPanel.Dock="Bottom"
                   TextWrapping="Wrap" FontSize="11"
                   Foreground="#6F737A" Margin="0,6,0,0" />
        <ScrollViewer>
          <StackPanel x:Name="PropertyRowsHost" Spacing="0" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border x:Name="ToolboxPanel"
            Grid.Row="0" Grid.Column="2"
            Background="#FCFCFD"
            BorderBrush="#D8DBDF"
            BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#F2F3F5"
                BorderBrush="#D8DBDF"
                BorderThickness="0,0,0,1"
                Padding="6,4">
          <TextBlock Text="基本组件"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#1F2328" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <WrapPanel x:Name="ToolboxTiles"
                     Orientation="Horizontal"
                     Margin="3" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3"
               Text="选择控件后可拖动、缩放或编辑属性。"
               FontSize="11" Foreground="#6F737A"
               Margin="10,4" />
  </Grid>
</UserControl>
