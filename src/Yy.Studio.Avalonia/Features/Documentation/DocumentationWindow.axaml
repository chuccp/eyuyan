<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yy.Studio.Avalonia.Features.Documentation.DocumentationWindow"
        Title="易语开发文档"
        Width="1120"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F7FB"
        KeyDown="OnWindowKeyDown">
  <Window.Styles>
    <Style Selector="ListBox#TopicList > ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="Foreground" Value="#33404F" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="ItemBorder"
                  Background="Transparent"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox#TopicList > ListBoxItem:pointerover /template/ Border#ItemBorder">
      <Setter Property="Background" Value="#E8EEF7" />
    </Style>
    <Style Selector="ListBox#TopicList > ListBoxItem:selected /template/ Border#ItemBorder">
      <Setter Property="Background" Value="#DCE8FB" />
    </Style>
    <Style Selector="ListBox#TopicList > ListBoxItem:selected">
      <Setter Property="Foreground" Value="#3574F0" />
    </Style>
  </Window.Styles>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Background="#FFFFFF"
            BorderBrush="#E6EAF0"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E6EAF0"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal"
                      Margin="18,0"
                      Spacing="12"
                      VerticalAlignment="Center">
            <TextBlock Text="易语开发文档"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <TextBlock Text="语言 · SDK · 命令参考"
                       Foreground="#667085"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" MinWidth="220" MaxWidth="380" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="#FCFDFE"
                  BorderBrush="#E6EAF0"
                  BorderThickness="0,0,1,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="14,13,14,10" Spacing="7">
                <TextBlock Text="开发文档"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="语言、系统 SDK 与内置命令"
                           FontSize="11"
                           Foreground="#667085"
                           Margin="0,0,0,4" />
                <TextBox x:Name="SearchBox"
                         Watermark="搜索语言、SDK 或命令"
                         Height="32"
                         Padding="8,4"
                         CornerRadius="6"
                         TextChanged="OnSearchTextChanged" />
                <ComboBox x:Name="SectionFilter"
                          Height="30"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnSectionChanged" />
              </StackPanel>

              <TextBlock x:Name="NoResultsText"
                         DockPanel.Dock="Bottom"
                         Text="没有匹配的文档"
                         IsVisible="False"
                         Margin="14,8,14,12"
                         Foreground="#667085"
                         FontSize="11" />

              <ListBox x:Name="TopicList"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0,2,0,8"
                       SelectionChanged="OnTopicSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding SectionHeader}"
                                 IsVisible="{Binding HasSectionHeader}"
                                 Margin="4,10,0,3"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="#667085" />
                      <TextBlock Text="{Binding Title}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}"
                                 Margin="0,2,0,0"
                                 FontSize="10.5"
                                 Foreground="#667085"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1"
                        Background="Transparent"
                        ResizeDirection="Columns" />

          <Border Grid.Column="2"
                  Background="#FFFFFF"
                  CornerRadius="10"
                  ClipToBounds="True">
            <DockPanel>
              <Border DockPanel.Dock="Top"
                      Padding="30,22,30,16"
                      BorderBrush="#E6EAF0"
                      BorderThickness="0,0,0,1">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="DocSectionText"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Foreground="#3574F0" />
                  <TextBlock x:Name="DocTitleText"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="#20252B"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="DocSummaryText"
                             FontSize="12.5"
                             Foreground="#667085"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="30,20,30,32">
                <StackPanel x:Name="BlocksPanel"
                            MaxWidth="920"
                            HorizontalAlignment="Stretch" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
