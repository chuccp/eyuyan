<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="现代特性">
  <yy:子程序 名称="创建版本" 返回类型="对象">
    <yy:参数 名称="名称" 类型="文本" />
    <yy:参数 名称="版本号" 类型="数字" 默认值="3" />
    <yy:返回 值="{名称: 名称, 版本号: 版本号, 标签: [&quot;中文&quot;, &quot;Windows 原生&quot;]}" />
  </yy:子程序>
  <yy:入口>
    <yy:变量 名称="信息" 类型="对象" 值="创建版本(&quot;易语 Studio&quot;)" />
    <yy:变量 名称="JSON文本" 类型="文本" 值="JSON生成(信息)" />
    <yy:调用 值="输出(JSON文本)" />
    <yy:变量 名称="解析结果" 类型="对象" 值="JSON解析(JSON文本)" />
    <yy:调用 值="输出((&quot;读取版本：&quot; + 解析结果.版本号))" />
    <yy:尝试 捕获="错误">
      <yy:变量 名称="风险值" 类型="数字" 值="(10 / 0)" />
      <yy:调用 值="输出(风险值)" />
      <yy:否则>
        <yy:调用 值="输出((&quot;异常保护捕获：&quot; + 错误))" />
      </yy:否则>
    </yy:尝试>
    <yy:变量 名称="平方数" 类型="数组" 值="[]" />
    <yy:计数循环 变量="序号" 从="1" 到="8" 步长="1">
      <yy:调用 值="追加(平方数, 幂(序号, 2))" />
    </yy:计数循环>
    <yy:调用 值="输出((&quot;平方数：&quot; + 平方数))" />
  </yy:入口>
</yy:代码>