<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="入门示例">
  <yy:子程序 名称="计算平均分" 返回类型="数字">
    <yy:参数 名称="成绩" 类型="数组" />
    <yy:变量 名称="总和" 类型="数字" 值="0" />
    <yy:遍历 变量="分数" 值="成绩">
      <yy:赋值 目标="总和" 运算符="+=" 值="分数" />
    </yy:遍历>
    <yy:如果 条件="(长度(成绩) == 0)">
      <yy:返回 值="0" />
    </yy:如果>
    <yy:返回 值="(总和 / 长度(成绩))" />
  </yy:子程序>
  <yy:入口>
    <yy:变量 名称="学生" 类型="对象" 值="{姓名: &quot;林川&quot;, 成绩: [92, 88, 96, 90]}" />
    <yy:变量 名称="平均分" 类型="数字" 值="计算平均分(学生.成绩)" />
    <yy:调用 值="输出((&quot;学生：&quot; + 学生.姓名))" />
    <yy:调用 值="输出((&quot;平均分：&quot; + 小数(平均分, 1)))" />
    <yy:如果 条件="(平均分 &gt;= 90)">
      <yy:调用 值="提示(&quot;成绩达到优秀。&quot;)" />
      <yy:否则>
        <yy:如果 条件="(平均分 &gt;= 60)">
          <yy:调用 值="输出(&quot;成绩及格。&quot;)" />
          <yy:否则>
            <yy:调用 值="输出(&quot;需要继续努力。&quot;)" />
          </yy:否则>
        </yy:如果>
      </yy:否则>
    </yy:如果>
  </yy:入口>
</yy:代码>