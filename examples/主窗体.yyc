<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="主窗体代码">
  <yy:子程序 名称="_主窗口_创建完毕">
    <yy:调用 值="输出(&quot;客户登记窗体已载入。&quot;)" />
  </yy:子程序>
  <yy:子程序 名称="_姓名输入框_内容被改变">
    <yy:赋值 目标="标题标签.文本" 运算符="=" 值="(&quot;你好，&quot; + 姓名输入框.文本)" />
  </yy:子程序>
  <yy:子程序 名称="_保存按钮_被单击">
    <yy:如果 条件="(修剪(姓名输入框.文本) == &quot;&quot;)">
      <yy:调用 值="提示(&quot;请先填写客户姓名。&quot;)" />
      <yy:返回 值="" />
    </yy:如果>
    <yy:调用 值="输出((&quot;已保存客户：&quot; + 姓名输入框.文本))" />
    <yy:调用 值="提示(&quot;客户信息已保存。&quot;)" />
    <yy:赋值 目标="姓名输入框.文本" 运算符="=" 值="(&quot;已保存：&quot; + 姓名输入框.文本)" />
  </yy:子程序>
  <yy:子程序 名称="_主窗口_将被销毁">
    <yy:调用 值="输出(&quot;客户登记窗体已关闭。&quot;)" />
  </yy:子程序>
</yy:代码>