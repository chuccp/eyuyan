<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="_启动窗口代码">
  <yy:子程序 名称="__启动窗口_创建完毕" />
  <yy:子程序 名称="__启动窗口_将被销毁" />
  <yy:子程序 名称="_应用按钮_被单击">
    <yy:赋值 目标="结果标签.文本" 运算符="=" 值="&quot;图标资源已加载，你好，&quot; + 姓名输入框.文本" />
    <yy:赋值 目标="窗口.标题" 运算符="=" 值="&quot;MCP 资源演示 · 已就绪&quot;" />
  </yy:子程序>
</yy:代码>