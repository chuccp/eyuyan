<yy:窗体 xmlns:yy="urn:yy-studio:form:1" 标识="@id/_启动窗口" 名称="_启动窗口" 标题="MCP 资源演示" 宽="720" 高="460" 背景="#F3F7F6" 图标="@资源/图片/应用图标" 边框="可调边框">
