.程序集 窗口程序集1
导入包 "系统.基础"
导入包 "系统.集合"
导入包 "系统.文本"
导入包 "系统.界面"
导入包 "系统.文件"

子程序 __启动窗口_创建完毕()
    变量 列表 = 取目录文件(路径框.文本, "*.png")
    如果 长度(列表) > 0 则
        图片框1.图片 = 列表[0]
        文件名标签.标题 = 列表[0]
        索引框.文本 = "0"
    否则
        文件名标签.标题 = "未找到 PNG 图片"
    结束如果
结束子程序

子程序 _上一张按钮_被单击()
    变量 列表 = 取目录文件(路径框.文本, "*.png")
    变量 计数 = 长度(列表)
    变量 索引 = 数字(索引框.文本) - 1
    如果 计数 == 0 则
        文件名标签.标题 = "未找到 PNG 图片"
    否则
        如果 索引 < 0 则
            索引 = 计数 - 1
        结束如果
        索引框.文本 = 文本(索引)
        图片框1.图片 = 列表[索引]
        文件名标签.标题 = 文本(索引 + 1) + "/" + 文本(计数) + "  " + 列表[索引]
    结束如果
结束子程序

子程序 _下一张按钮_被单击()
    变量 列表 = 取目录文件(路径框.文本, "*.png")
    变量 计数 = 长度(列表)
    变量 索引 = 数字(索引框.文本) + 1
    如果 计数 == 0 则
        文件名标签.标题 = "未找到 PNG 图片"
    否则
        如果 索引 >= 计数 则
            索引 = 0
        结束如果
        索引框.文本 = 文本(索引)
        图片框1.图片 = 列表[索引]
        文件名标签.标题 = 文本(索引 + 1) + "/" + 文本(计数) + "  " + 列表[索引]
    结束如果
结束子程序
