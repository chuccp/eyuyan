<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="窗口程序集1">
  <yy:子程序 名称="__启动窗口_创建完毕">
    <yy:变量 名称="列表" 值="取目录文件(路径框.文本, &quot;*.png&quot;)" />
    <yy:如果 条件="(长度(列表) &gt; 0)">
      <yy:赋值 目标="图片框1.图片" 运算符="=" 值="列表[0]" />
      <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="列表[0]" />
      <yy:赋值 目标="索引框.文本" 运算符="=" 值="&quot;0&quot;" />
      <yy:否则>
        <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="&quot;未找到 PNG 图片&quot;" />
      </yy:否则>
    </yy:如果>
  </yy:子程序>
  <yy:子程序 名称="_上一张按钮_被单击">
    <yy:变量 名称="列表" 值="取目录文件(路径框.文本, &quot;*.png&quot;)" />
    <yy:变量 名称="计数" 值="长度(列表)" />
    <yy:变量 名称="索引" 值="(数字(索引框.文本) - 1)" />
    <yy:如果 条件="(计数 == 0)">
      <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="&quot;未找到 PNG 图片&quot;" />
      <yy:否则>
        <yy:如果 条件="(索引 &lt; 0)">
          <yy:赋值 目标="索引" 运算符="=" 值="(计数 - 1)" />
        </yy:如果>
        <yy:赋值 目标="索引框.文本" 运算符="=" 值="文本(索引)" />
        <yy:赋值 目标="图片框1.图片" 运算符="=" 值="列表[索引]" />
        <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="((((文本((索引 + 1)) + &quot;/&quot;) + 文本(计数)) + &quot;  &quot;) + 列表[索引])" />
      </yy:否则>
    </yy:如果>
  </yy:子程序>
  <yy:子程序 名称="_下一张按钮_被单击">
    <yy:变量 名称="列表" 值="取目录文件(路径框.文本, &quot;*.png&quot;)" />
    <yy:变量 名称="计数" 值="长度(列表)" />
    <yy:变量 名称="索引" 值="(数字(索引框.文本) + 1)" />
    <yy:如果 条件="(计数 == 0)">
      <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="&quot;未找到 PNG 图片&quot;" />
      <yy:否则>
        <yy:如果 条件="(索引 &gt;= 计数)">
          <yy:赋值 目标="索引" 运算符="=" 值="0" />
        </yy:如果>
        <yy:赋值 目标="索引框.文本" 运算符="=" 值="文本(索引)" />
        <yy:赋值 目标="图片框1.图片" 运算符="=" 值="列表[索引]" />
        <yy:赋值 目标="文件名标签.标题" 运算符="=" 值="((((文本((索引 + 1)) + &quot;/&quot;) + 文本(计数)) + &quot;  &quot;) + 列表[索引])" />
      </yy:否则>
    </yy:如果>
  </yy:子程序>
</yy:代码>