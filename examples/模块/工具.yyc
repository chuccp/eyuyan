<yy:代码 xmlns:yy="urn:yy-studio:code:1" 格式版本="1" 名称="模块示例">
  <yy:子程序 名称="取欢迎语" 返回类型="文本">
    <yy:参数 名称="姓名" 类型="文本" />
    <yy:返回 值="((&quot;欢迎，&quot; + 姓名) + &quot;！&quot;)" />
  </yy:子程序>
  <yy:子程序 名称="计算折扣" 返回类型="数字">
    <yy:参数 名称="原价" 类型="数字" />
    <yy:参数 名称="折扣" 类型="数字" 默认值="0.9" />
    <yy:如果 条件="(原价 &lt; 0)">
      <yy:返回 值="0" />
    </yy:如果>
    <yy:返回 值="(原价 * 折扣)" />
  </yy:子程序>
</yy:代码>