<Application x:Class="Yy.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <!-- IDEA 新 UI 浅色主题。键名保持稳定，控件和视图只引用语义颜色。 -->
        <SolidColorBrush x:Key="WindowBrush" Color="#F7F7F8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FCFCFD" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DBDF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6F737A" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3574F0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C86F5" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A87924" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C94F4F" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E62" />

        <SolidColorBrush x:Key="FaceBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="SunkenShadowBrush" Color="#D7DADE" />
        <SolidColorBrush x:Key="SunkenDarkBrush" Color="#8F949B" />
        <SolidColorBrush x:Key="SunkenLightBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HintBrush" Color="#F7F7F8" />
        <SolidColorBrush x:Key="EditorBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#E8EAED" />
        <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolTipBrush" Color="#FFFFFF" />

        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Classic.xaml" />
        </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
